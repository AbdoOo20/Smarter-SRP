<bases1:UserControlBase x:Class="Leapay.Client.UserInterface.Misc.Configuration.CompanyInfoPage"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:bases1="clr-namespace:Leapay.Client.Polymorphism.Bases"
                        xmlns:configuration="clr-namespace:Leapay.Client.UserInterface.Misc.Configuration"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:suki="https://github.com/kikipoulet/SukiUI"
                        d:DataContext="{d:DesignInstance configuration:CompanyInfoPage,
                                                         IsDesignTimeCreatable=False}"
                        d:DesignHeight="450"
                        d:DesignWidth="800"
                        x:DataType="configuration:CompanyInfoPage"
                        FlowDirection="{CompiledBinding ViewModel.FlowDirection}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        mc:Ignorable="d">
    <ScrollViewer Margin="0,25,0,0">
        <StackPanel Spacing="5">
            <WrapPanel Margin="10,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top">
                <suki:GlassCard>
                    <StackPanel>
                        <StackPanel>
                            <suki:InfoBar FontSize="20"
                                          IsClosable="False"
                                          IsOpen="True"
                                          IsVisible="True"
                                          Message="{Binding ViewModel[SelectLogoFileInfo]}" />

                            <Border ClipToBounds="True" CornerRadius="20">
                                <Image Width="200"
                                       Height="200"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Source="{Binding ViewModel.CompanyInfo.ImageData, Converter={StaticResource ByteArrayToBitmapConverter}}" />
                            </Border>

                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ViewModel.BrowseImageCommand}"
                                    Content="{Binding ViewModel[BrowseFile]}" />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   ItemSpacing="10"
                                   Orientation="Horizontal">

                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[CompanyName]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.Name}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[CompanyType]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.Type}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PhoneNumber1]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.PhoneNumber1}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PhoneNumber2]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.PhoneNumber2}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Address]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.Address}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Email]}" />
                                <TextBox MinWidth="300"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.CompanyInfo.Email}" />
                            </StackPanel>


                            <StackPanel Width="300">
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNotice]}" />
                                <TextBox MinHeight="100"
                                         Margin="0,10,0,0"
                                         MinLines="1"
                                         Text="{Binding ViewModel.CompanyInfo.InvoiceNotice}" />
                            </StackPanel>
                        </WrapPanel>

                    </StackPanel>
                </suki:GlassCard>

            </WrapPanel>

            <Button Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Classes="Flat Rounded"
                    Command="{Binding ViewModel.SaveCommand}"
                    Content="{Binding ViewModel[SaveButton]}" />
        </StackPanel>

    </ScrollViewer>
</bases1:UserControlBase>