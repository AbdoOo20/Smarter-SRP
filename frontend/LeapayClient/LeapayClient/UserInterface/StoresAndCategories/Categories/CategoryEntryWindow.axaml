<UserControl x:Class="Leapay.Client.UserInterface.StoresAndCategories.Categories.CategoryEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:categories="clr-namespace:Leapay.Client.UserInterface.StoresAndCategories.Categories"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="600"
             Height="350"
             d:DataContext="{d:DesignInstance categories:CategoryEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="350"
             d:DesignWidth="600"
             x:DataType="categories:CategoryEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="25,40,25,0">
            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Name]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Name}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Note]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Description}" />
            </StackPanel>

            <StackPanel MinWidth="150" Margin="0,0">
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[ParentCategory]}" />
                <ComboBox Margin="0,10,0,0"
                          ItemsSource="{Binding ViewModel.Categories.Items}"
                          SelectedItem="{Binding ViewModel.Categories.SelectedItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="0,0,0,0"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{Binding ViewModel[CancelButton]}" />
                <Button Margin="15,0,0,0"
                        Command="{Binding ViewModel.SaveCommand}"
                        Content="{Binding ViewModel[SaveButton]}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>