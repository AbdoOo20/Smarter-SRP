<bases1:UserControlBase x:Class="Leapay.Client.UserInterface.Reports.Navigator.ReportsNavigatorPage"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                        xmlns:bases1="clr-namespace:Leapay.Client.Polymorphism.Bases"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:navigator="clr-namespace:Leapay.Client.UserInterface.Reports.Navigator"
                        xmlns:suki="https://github.com/kikipoulet/SukiUI"
                        xmlns:uiModels="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels.UiModels"
                        d:DataContext="{d:DesignInstance navigator:ReportsNavigatorPage,
                                                         IsDesignTimeCreatable=False}"
                        d:DesignHeight="450"
                        d:DesignWidth="800"
                        x:DataType="navigator:ReportsNavigatorPage"
                        FlowDirection="{CompiledBinding ViewModel.FlowDirection}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        mc:Ignorable="d">
    <ItemsControl ItemsSource="{Binding ViewModel.Expanders}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type uiModels:ExpanderModel}">
                <suki:GroupBox Width="{Binding $parent.Width}"
                               Margin="15"
                               Header="{Binding Name}"
                               IsVisible="{Binding Visibility}">
                    <StackPanel>
                        <ItemsControl MaxWidth="{Binding $parent.Width}"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type uiModels:CardModel}">
                                    <suki:GlassCard Width="300"
                                                    Height="65"
                                                    Margin="5"
                                                    Command="{Binding ActionCommand}"
                                                    IsInteractive="True"
                                                    IsVisible="{Binding IsVisible}">
                                        <StackPanel Orientation="Horizontal">
                                            <avalonia:MaterialIcon Kind="{Binding CardSymbol}" />
                                            <TextBlock Margin="10,0,0,0" Text="{Binding CardName, Converter={StaticResource LocaleConverter}}" />
                                        </StackPanel>
                                    </suki:GlassCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </suki:GroupBox>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</bases1:UserControlBase>