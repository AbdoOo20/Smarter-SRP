<bases1:UserControlBase x:Class="Leapay.Client.UserInterface.Reports.GeneralReport.GeneralReportPage"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                        xmlns:bases1="clr-namespace:Leapay.Client.Polymorphism.Bases"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:generalReport="clr-namespace:Leapay.Client.UserInterface.Reports.GeneralReport"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:requests="clr-namespace:Fly.Shared.Modules.Global.Requests;assembly=Fly.Shared"
                        xmlns:suki="https://github.com/kikipoulet/SukiUI"
                        d:DataContext="{d:DesignInstance generalReport:GeneralReportPage,
                                                         IsDesignTimeCreatable=False}"
                        d:DesignHeight="450"
                        d:DesignWidth="800"
                        x:DataType="generalReport:GeneralReportPage"
                        FlowDirection="{CompiledBinding ViewModel.FlowDirection}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        SizeChanged="OnDataSizeChanged"
                        mc:Ignorable="d">
    <ScrollViewer Margin="0,10,0,0">
        <DockPanel>
            <StackPanel Margin="0,0,0,0"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ViewModel.IsRefreshing, Converter={StaticResource ReverseBoolConverter}}">
                <DockPanel>
                    <TextBlock Margin="15,0,0,0"
                               FontSize="22"
                               FontWeight="Bold"
                               Text="{Binding ViewModel.Title}" />

                    <StackPanel Margin="0,0,25,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Width="80"
                                Height="37"
                                Margin="0,0,7,0"
                                Classes="Flat Rounded"
                                Command="{Binding ViewModel.RequestPrintCommand}"
                                Content="{Binding ViewModel[Print]}" />
                        <Button Width="80"
                                Height="37"
                                Classes="Flat Rounded"
                                Command="{Binding ViewModel.QueryCommand}"
                                Content="{Binding ViewModel[Query]}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="5,5,0,0">
                    <suki:GlassCard Margin="0,0,25,0">
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel HorizontalAlignment="Left"
                                        IsVisible="{Binding ViewModel.DatesVisibility}"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,5,0,0" Text="{Binding ViewModel[StartDate]}" />
                                <DatePicker MinWidth="120"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.StartDate, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Margin="10,5,0,0"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding ViewModel.DatesVisibility}"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[EndDate]}" />
                                <DatePicker MinWidth="120"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.EndDate}" />
                            </StackPanel>

                            <StackPanel Margin="10,5,0,0" IsVisible="{Binding ViewModel.AccountTypeVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[AccountType]}" />
                                <ComboBox MinWidth="110"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding ViewModel.AccountType.Items}"
                                          SelectedItem="{Binding ViewModel.AccountType.SelectedItem}" />
                            </StackPanel>

                            <StackPanel x:Name="MainComboPanel"
                                        Margin="10,10,0,0"
                                        IsVisible="{Binding ViewModel.ComboVisibility}" />

                            <WrapPanel x:Name="CombosWrap" Margin="0,10,0,0" />

                            <ItemsControl Margin="5,-2,0,0"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding ViewModel.DynamicFields}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type requests:DynamicField}">
                                        <StackPanel Margin="5,0,0,0" Orientation="Vertical">
                                            <TextBlock Margin="0,8,0,0" Text="{Binding Title}" />
                                            <TextBox MinWidth="120"
                                                     Margin="0,8,0,0"
                                                     Text="{Binding Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </suki:GlassCard>
                </StackPanel>
            </StackPanel>

            <suki:Loading Width="60"
                          Height="60"
                          Margin="25,200,0,0"
                          HorizontalAlignment="Center"
                          DockPanel.Dock="Top"
                          IsVisible="{Binding ViewModel.IsRefreshing}" />

            <StackPanel Margin="5,7,0,0" IsVisible="{Binding ViewModel.DataVisibility}">
                <WrapPanel x:Name="UpperPanel"
                           MaxWidth="{Binding $parent.Width}"
                           ItemSpacing="8"
                           Orientation="Horizontal" />
                <ScrollViewer x:Name="DataScroller"
                              Padding="0,5,0,25"
                              HorizontalScrollBarVisibility="Visible">
                    <StackPanel x:Name="DataGrid" />
                </ScrollViewer>
                <WrapPanel x:Name="LowerPanel"
                           MaxWidth="{Binding $parent.Width}"
                           ItemSpacing="8"
                           Orientation="Horizontal" />
            </StackPanel>
        </DockPanel>
    </ScrollViewer>
</bases1:UserControlBase>