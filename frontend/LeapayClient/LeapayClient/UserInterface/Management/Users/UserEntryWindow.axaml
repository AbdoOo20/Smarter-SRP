<UserControl x:Class="Leapay.Client.UserInterface.Management.Users.UserEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Leapay.Client.Behaviours"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:users="clr-namespace:Leapay.Client.UserInterface.Management.Users"
             Width="600"
             Height="670"
             d:DataContext="{d:DesignInstance users:UserEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="420"
             d:DesignWidth="600"
             x:DataType="users:UserEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <StackPanel Margin="0,40,0,0">
        <TabControl Margin="10"
                    VerticalAlignment="Top"
                    VerticalContentAlignment="Top">
            <TabControl.Items>
                <TabItem Header="{Binding ViewModel[UserInfo]}">
                    <suki:GlassCard MinHeight="420">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Name]}" />
                                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Name}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[UsernamePlaceholder]}" />
                                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Phone}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Password]}" />
                                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Password}" />
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Group]}" />
                                <ComboBox MinWidth="200"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding ViewModel.Groups.Items}"
                                          SelectedItem="{Binding ViewModel.Groups.SelectedItem}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </suki:GlassCard>
                </TabItem>

                <TabItem VerticalAlignment="Top"
                         VerticalContentAlignment="Top"
                         Header="{Binding ViewModel[UserDefaultsAndPermissions]}">
                    <suki:GlassCard MinHeight="420">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel MinWidth="160">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DefaultSafe]}" />
                                    <ComboBox Margin="0,10,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.SafesCombo.Items}"
                                              SelectedItem="{Binding ViewModel.SafesCombo.SelectedItem}" />
                                </StackPanel>

                                <StackPanel MinWidth="160">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DefaultStorage]}" />
                                    <ComboBox Margin="0,10,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.StoragesCombo.Items}"
                                              SelectedItem="{Binding ViewModel.StoragesCombo.SelectedItem}" />
                                </StackPanel>
                                <StackPanel MinWidth="160">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DefaultBank]}" />
                                    <ComboBox Margin="0,10,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.BanksCombo.Items}"
                                              SelectedItem="{Binding ViewModel.BanksCombo.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>


                            <StackPanel Orientation="Horizontal">
                                <StackPanel MinWidth="235">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DefaultPaymentType]}" />
                                    <ComboBox Margin="0,10,0,0"
                                              ItemsSource="{Binding ViewModel.PaymentTypes.Items}"
                                              SelectedItem="{Binding ViewModel.PaymentTypes.SelectedItem}" />
                                </StackPanel>

                                <StackPanel MinWidth="235">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DefaultStorageType]}" />
                                    <ComboBox Margin="0,10,0,0"
                                              ItemsSource="{Binding ViewModel.StorageTypes.Items}"
                                              SelectedItem="{Binding ViewModel.StorageTypes.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <TabControl>
                                <TabControl.Items>
                                    <TabItem VerticalAlignment="Top"
                                             VerticalContentAlignment="Top"
                                             Header="{Binding ViewModel[VisibleSafes]}">
                                        <suki:GlassCard MinHeight="210"
                                                        VerticalAlignment="Top"
                                                        VerticalContentAlignment="Top">
                                            <StackPanel VerticalAlignment="Top">
                                                <ScrollViewer VerticalAlignment="Top">
                                                    <ListBox MaxHeight="200"
                                                             Margin="0,10,0,0"
                                                             ItemsSource="{Binding ViewModel.Safes}"
                                                             SelectionMode="Multiple,Toggle">
                                                        <Interaction.Behaviors>
                                                            <behaviours:MultiSelectBehaviour SelectedItems="{Binding ViewModel.SelectedSafes}" />
                                                        </Interaction.Behaviors>

                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                                                <StackPanel Margin="5" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Display}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </TabItem>

                                    <TabItem VerticalAlignment="Top"
                                             VerticalContentAlignment="Top"
                                             Header="{Binding ViewModel[VisibleStorages]}">
                                        <suki:GlassCard MinHeight="210"
                                                        VerticalAlignment="Top"
                                                        VerticalContentAlignment="Top">
                                            <StackPanel VerticalAlignment="Top">
                                                <ScrollViewer VerticalAlignment="Top">
                                                    <ListBox MaxHeight="280"
                                                             Margin="0,10,0,0"
                                                             ItemsSource="{Binding ViewModel.Storages}"
                                                             SelectionMode="Multiple,Toggle">
                                                        <Interaction.Behaviors>
                                                            <behaviours:MultiSelectBehaviour SelectedItems="{Binding ViewModel.SelectedStorages}" />
                                                        </Interaction.Behaviors>

                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                                                <StackPanel Margin="5" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Display}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </TabItem>

                                    <TabItem VerticalAlignment="Top"
                                             VerticalContentAlignment="Top"
                                             Header="{Binding ViewModel[VisibleBanks]}">
                                        <suki:GlassCard MinHeight="210"
                                                        VerticalAlignment="Top"
                                                        VerticalContentAlignment="Top">
                                            <StackPanel VerticalAlignment="Top">
                                                <ScrollViewer VerticalAlignment="Top">
                                                    <ListBox MaxHeight="280"
                                                             Margin="0,10,0,0"
                                                             ItemsSource="{Binding ViewModel.Banks}"
                                                             SelectionMode="Multiple,Toggle">
                                                        <Interaction.Behaviors>
                                                            <behaviours:MultiSelectBehaviour SelectedItems="{Binding ViewModel.SelectedBanks}" />
                                                        </Interaction.Behaviors>

                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                                                <StackPanel Margin="5" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Display}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </suki:GlassCard>
                                    </TabItem>

                                </TabControl.Items>
                            </TabControl>
                        </StackPanel>

                    </suki:GlassCard>
                </TabItem>
            </TabControl.Items>
        </TabControl>

        <StackPanel Margin="25,10,25,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button Margin="0,0,0,0"
                    Command="{Binding ViewModel.CancelCommand}"
                    Content="{Binding ViewModel[CancelButton]}" />
            <Button Margin="15,0,0,0"
                    Command="{Binding ViewModel.SaveCommand}"
                    Content="{Binding ViewModel[SaveButton]}" />
        </StackPanel>
    </StackPanel>

</UserControl>