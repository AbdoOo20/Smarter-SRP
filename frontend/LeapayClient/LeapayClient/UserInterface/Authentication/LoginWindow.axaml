<suki:SukiWindow
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="350"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="450"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance authentication1:LoginWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="350"
    d:DesignWidth="450"
    mc:Ignorable="d"
    x:Class="Leapay.Client.UserInterface.Authentication.LoginWindow"
    x:DataType="authentication1:LoginWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:authentication1="clr-namespace:Leapay.Client.UserInterface.Authentication"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <suki:GlassCard Margin="0,0,0,25" Width="300">
            <suki:BusyArea
                BusyText="Signing In..."
                IsBusy="{Binding ViewModel.IsRefreshing}"
                Name="BusySignIn">
                <StackPanel>
                    <avalonia:MaterialIcon
                        Foreground="{DynamicResource SukiPrimaryColor}"
                        Height="30"
                        HorizontalAlignment="Center"
                        Kind="MicrosoftEdge"
                        Margin="10"
                        Width="30" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="DemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,27"
                        Text="{Binding ViewModel.InfoText}" />
                    <TextBlock
                        FontWeight="DemiBold"
                        Foreground="{DynamicResource SukiLowText}"
                        Margin="6,0,0,3"
                        Text="Username" />
                    <TextBox
                        Text="{Binding ViewModel.Username}"
                        Watermark="John"
                        suki:TextBoxExtensions.Prefix="" />
                    <TextBlock
                        FontWeight="DemiBold"
                        Foreground="{DynamicResource SukiLowText}"
                        Margin="6,18,0,3"
                        Text="Password" />
                    <TextBox
                        Margin="0,0,0,25"
                        Name="PasswordTextBox"
                        PasswordChar="*"
                        Text="{Binding ViewModel.Password}"
                        suki:TextBoxExtensions.AddDeleteButton="False" />
                </StackPanel>
            </suki:BusyArea>
        </suki:GlassCard>
        <Button
            Classes="Flat Rounded"
            Command="{Binding ViewModel.LoginCommand}"
            FontWeight="DemiBold"
            Height="40"
            HorizontalAlignment="Center"
            Margin="0,0,0,7"
            Name="ButtonSignIn"
            VerticalAlignment="Bottom"
            Width="160"
            suki:ButtonExtensions.ShowProgress="{Binding ViewModel.IsRefreshing}">
            Sign In
        </Button>
    </Grid>
</suki:SukiWindow>
