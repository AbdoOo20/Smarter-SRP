<UserControl x:Class="Leapay.Client.UserInterface.FinancingOperations.OperationWindows.MarketerFinanceEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:operationWindows="clr-namespace:Leapay.Client.UserInterface.FinancingOperations.OperationWindows"
             Width="600"
             d:DataContext="{d:DesignInstance operationWindows:MarketerFinanceEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="640"
             d:DesignWidth="600"
             x:DataType="operationWindows:MarketerFinanceEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="25,5,25,0">

                <StackPanel IsVisible="{Binding ViewModel.SerialNumberVisibility}">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SerialNumber]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.SerialNumber}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[MarketerName]}" />
                    <ComboBox MinWidth="300"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                              SelectionChanged="MarketerSelected">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Amount]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ClientPrice}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Safe]}" />
                    <ComboBox MinWidth="300"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Notes]}" />
                    <TextBox MinHeight="100"
                             MaxHeight="100"
                             Margin="0,10,0,0"
                             MinLines="1"
                             Text="{Binding ViewModel.Model.Note}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,15,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <StackPanel Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding ViewModel[Percent]}" />
                        <TextBox MinWidth="100"
                                 Margin="0,5,0,0"
                                 Text="{Binding ViewModel.ClientPercentage}" />
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding ViewModel[Value]}" />
                        <TextBox MinWidth="100"
                                 Margin="0,5,0,0"
                                 IsEnabled="False"
                                 Text="{Binding ViewModel.ClientValue}" />
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding ViewModel[Remaining]}" />
                        <TextBox MinWidth="100"
                                 Margin="0,5,0,0"
                                 IsEnabled="False"
                                 Text="{Binding ViewModel.VisibleInfo, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Vertical">
                        <TextBlock Text="{Binding ViewModel[MarketerDebt]}" />
                        <TextBox MinWidth="100"
                                 Margin="0,5,0,0"
                                 IsEnabled="False"
                                 Text="{Binding ViewModel.MarketerDebt}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,25,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Margin="0,0,0,0"
                            Command="{Binding ViewModel.CancelCommand}"
                            Content="{Binding ViewModel[CancelButton]}" />
                    <Button Margin="15,0,0,0"
                            Command="{Binding ViewModel.SaveCommand}"
                            Content="{Binding ViewModel[SaveButton]}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>