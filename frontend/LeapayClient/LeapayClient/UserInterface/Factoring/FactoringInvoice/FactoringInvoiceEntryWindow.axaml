<UserControl x:Class="Leapay.Client.UserInterface.Factoring.FactoringInvoice.FactoringInvoiceEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:FactoringInvoice="clr-namespace:Leapay.Client.UserInterface.Factoring.FactoringInvoice"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             d:DataContext="{d:DesignInstance FactoringInvoice:FactoringInvoiceEntryWindow,
                                              IsDesignTimeCreatable=True}"
             x:DataType="FactoringInvoice:FactoringInvoiceEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ViewModel.RingVisibility}">
            <suki:Loading Width="65"
                          Height="65"
                          Margin="0,0,0,0"
                          HorizontalAlignment="Center"
                          DockPanel.Dock="Top"
                          IsVisible="{Binding ViewModel.IsRefreshing}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       Text="{Binding ViewModel.LoadingTitle}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Text="{Binding ViewModel.LoadingInfo}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ViewModel.UiVisibility}">
            <DockPanel Margin="0,0,0,0" VerticalSpacing="5">
                <StackPanel DockPanel.Dock="Top">
                    <suki:GlassCard Margin="25,0">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNumber]}" />
                                <TextBox MinWidth="80"
                                         Margin="0,10,0,0"
                                         IsReadOnly="True"
                                         Text="{Binding ViewModel.InvoiceNumber}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[StartDate]}" />
                                <DatePicker MinWidth="140"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.Model.Date, Converter={StaticResource DateOffsetConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[EndDate]}" />
                                <DatePicker MinWidth="140"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.Model.EndDate, Converter={StaticResource DateOffsetConverter}}" />
                            </StackPanel>

                            <suki:GlassCard Margin="10,15,0,0" Padding="15,3">
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding ViewModel.Model.IsInternal}" IsCheckedChanged="InternalFactoringCheckedChanged" />
                                    <TextBlock Margin="5,12,0,0" Text="{Binding ViewModel[IsFactoringInternal]}" />
                                </StackPanel>
                            </suki:GlassCard>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.FactoringSectorVisibility}">
                                <ContentControl Content="{Binding ViewModel.FactoringSectors.Content}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[PaymentType]}" />
                                <ComboBox MinWidth="120"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ViewModel.PaymentTypes.Items}"
                                          SelectedItem="{Binding ViewModel.PaymentTypes.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0">
                                <ContentControl Content="{Binding ViewModel.Clients.Content}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.SafeVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Safe]}" />
                                <ComboBox MinWidth="180"
                                          Margin="0,5,0,0"
                                          DisplayMemberBinding="{Binding Display}"
                                          ItemsSource="{Binding ViewModel.Safes.Items}"
                                          SelectedItem="{Binding ViewModel.Safes.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding ViewModel.BankVisibility}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Bank]}" />
                                    <ComboBox MinWidth="180"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.Banks.Items}"
                                              SelectedItem="{Binding ViewModel.Banks.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>


                            <StackPanel Margin="10,10,0,0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Store]}" />
                                <ComboBox MinWidth="180"
                                          Margin="0,5,0,0"
                                          DisplayMemberBinding="{Binding Display}"
                                          ItemsSource="{Binding ViewModel.Stores.Items}"
                                          SelectedItem="{Binding ViewModel.Stores.SelectedItem}" />
                            </StackPanel>

                            <StackPanel MinWidth="170" Margin="10,10,0,0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[PaymentStatus]}" />
                                <ComboBox MinWidth="150"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ViewModel.FactoringStatus.Items}"
                                          SelectedItem="{Binding ViewModel.FactoringStatus.SelectedItem}" />
                            </StackPanel>

                            <StackPanel MinWidth="170" Margin="10,10,0,0">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[FactoringItemsStatus]}" />
                                <ComboBox MinWidth="150"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ViewModel.FactoringItemsStatus.Items}"
                                          SelectedItem="{Binding ViewModel.FactoringItemsStatus.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.UpfrontCostVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[UpfrontClientCost]}" />
                                <TextBox MinWidth="100"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.Model.CollectionRate}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel[NotesDotted]}" />
                                <TextBox Width="{Binding Bounds.Width, Converter={StaticResource MathConverter}, ConverterParameter='-,180'}"
                                         Margin="3,5,0,0"
                                         Text="{Binding ViewModel.Model.Notes}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                        </WrapPanel>
                    </suki:GlassCard>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Margin="25,3,0,0">
                        <TabControl>
                            <TabControl.Items>
                                <TabItem Header="{Binding ViewModel[ManufacturedItemCompositions]}">
                                    <suki:GlassCard>
                                        <StackPanel>
                                            <suki:GlassCard Height="30"
                                                            MinWidth="200"
                                                            Padding="0"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="True">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Image Width="25"
                                                           Height="25"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Source="/Assets/InfoIcon.png" />
                                                    <TextBlock Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding ViewModel[TotalPriceDotted]}" />
                                                    <TextBlock Margin="3,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding ViewModel.TotalPrice}" />
                                                </StackPanel>
                                            </suki:GlassCard>
                                            <ScrollViewer x:Name="CompositionsDataScroller"
                                                          MaxHeight="550"
                                                          Margin="0,10,0,0"
                                                          Padding="5"
                                                          HorizontalScrollBarVisibility="Visible">
                                                <StackPanel x:Name="CompositionsDataGrid" />
                                            </ScrollViewer>

                                            <ScrollViewer Margin="0,0,0,5" HorizontalScrollBarVisibility="Visible">
                                                <DockPanel>
                                                    <suki:GlassCard HorizontalAlignment="Left">
                                                        <WrapPanel>
                                                            <StackPanel Margin="10,5"
                                                                        HorizontalAlignment="Center"
                                                                        Orientation="Horizontal">

                                                                <suki:GlassCard>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <suki:InfoBar x:Name="ItemCompositionInfoBar"
                                                                                      Title="{Binding ViewModel[ItemComposition]}"
                                                                                      Margin="0,0,0,0"
                                                                                      FontSize="24"
                                                                                      IsClosable="False"
                                                                                      IsOpen="True"
                                                                                      Message="{Binding ViewModel.SelectedItemCompositionStatus}" />

                                                                        <StackPanel Spacing="5">
                                                                            <Button Margin="5,0,0,0"
                                                                                    Command="{Binding ViewModel.SelectItemCompositionCommand}"
                                                                                    Content="{Binding ViewModel[SelectItemComposition]}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </suki:GlassCard>

                                                            </StackPanel>

                                                            <StackPanel Margin="10,5"
                                                                        HorizontalAlignment="Center"
                                                                        Orientation="Horizontal">

                                                                <StackPanel MinWidth="80"
                                                                            MaxWidth="80"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Quantity]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelCompositions.Model.Quantity, Converter={StaticResource TextBoxConverter}}" />
                                                                </StackPanel>

                                                                <StackPanel Margin="5,10,0,0">
                                                                    <TextBlock Margin="3,10,0,0" Text="{Binding ViewModel[CompositionNumber]}" />
                                                                    <ComboBox MinWidth="200"
                                                                              Margin="0,6,0,0"
                                                                              ItemsSource="{Binding ViewModel.AvailableIndices}"
                                                                              SelectedItem="{Binding ViewModel.ModelCompositions.Model.CompositionIndex}" />
                                                                </StackPanel>

                                                                <!--<StackPanel MinWidth="80"
                                                                            MaxWidth="150"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Price]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelCompositions.Model.Price}" />
                                                                </StackPanel>

                                                                <StackPanel MinWidth="80"
                                                                            MaxWidth="100"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Discount]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelCompositions.Model.Discount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>-->
                                                            </StackPanel>

                                                            <Button Width="50"
                                                                    Height="50"
                                                                    Margin="10,20,0,0"
                                                                    Command="{Binding ViewModel.CompositionSubmitCommand}">
                                                                <avalonia:MaterialIcon Margin="-4,0,0,0" Kind="{Binding ViewModel.ModelCompositions.Symbol}" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </suki:GlassCard>
                                                    <StackPanel MaxHeight="40"
                                                                Margin="0,5,0,0"
                                                                HorizontalAlignment="Right"
                                                                DockPanel.Dock="Bottom"
                                                                Orientation="Horizontal">

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button MinWidth="100"
                                                                    Margin="0,0,0,0"
                                                                    Command="{Binding ViewModel.CancelCommand}"
                                                                    Content="{Binding ViewModel[CancelButton]}" />
                                                            <Button MinWidth="100"
                                                                    Margin="15,0,0,0"
                                                                    Command="{Binding ViewModel.SavePrintCommand}"
                                                                    Content="{Binding ViewModel[SavePrintButton]}" />
                                                            <Button MinWidth="100"
                                                                    Margin="15,0,0,0"
                                                                    Command="{Binding ViewModel.SaveCommand}"
                                                                    Content="{Binding ViewModel[SaveButton]}" />
                                                        </StackPanel>

                                                    </StackPanel>
                                                </DockPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </suki:GlassCard>
                                </TabItem>
                                <TabItem Header="{Binding ViewModel[FactoringRawItemDetails]}">
                                    <suki:GlassCard>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <suki:GlassCard Height="30"
                                                                MinWidth="200"
                                                                Padding="0"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="True">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Image Width="25"
                                                               Height="25"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Source="/Assets/InfoIcon.png" />
                                                        <TextBlock Margin="5,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding ViewModel[TotalPriceDotted]}" />
                                                        <TextBlock Margin="3,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding ViewModel.TotalPrice}" />
                                                    </StackPanel>
                                                </suki:GlassCard>

                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[CompositionFilter]}" />
                                                    <ComboBox MinWidth="200"
                                                              Margin="0,0,0,0"
                                                              DisplayMemberBinding="{Binding Display}"
                                                              ItemsSource="{Binding ViewModel.CompositionFilter.Items}"
                                                              SelectedItem="{Binding ViewModel.CompositionFilter.SelectedItem}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <ScrollViewer x:Name="DataScroller"
                                                          MaxHeight="550"
                                                          Margin="0,10,0,0"
                                                          Padding="5"
                                                          HorizontalScrollBarVisibility="Visible">
                                                <StackPanel x:Name="DataGrid" />
                                            </ScrollViewer>

                                            <ScrollViewer Margin="0,0,0,5" HorizontalScrollBarVisibility="Visible">
                                                <DockPanel>
                                                    <suki:GlassCard HorizontalAlignment="Left">
                                                        <WrapPanel>
                                                            <StackPanel Margin="10,5"
                                                                        HorizontalAlignment="Center"
                                                                        Orientation="Horizontal">

                                                                <suki:GlassCard>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <suki:InfoBar x:Name="ItemInfoBar"
                                                                                      Title="{Binding ViewModel[Item]}"
                                                                                      Margin="0,0,0,0"
                                                                                      FontSize="24"
                                                                                      IsClosable="False"
                                                                                      IsOpen="True"
                                                                                      Message="{Binding ViewModel.SelectedItemStatus}" />

                                                                        <StackPanel Spacing="5">
                                                                            <Button Width="120"
                                                                                    Margin="5,0,0,0"
                                                                                    Command="{Binding ViewModel.SelectItemCommand}"
                                                                                    Content="{Binding ViewModel[SelectItem]}" />
                                                                            <Button Width="120"
                                                                                    Margin="5,0,0,0"
                                                                                    Command="{Binding ViewModel.SelectItemsCommand}"
                                                                                    Content="{Binding ViewModel[SelectItems]}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </suki:GlassCard>

                                                            </StackPanel>

                                                            <StackPanel Margin="10,5"
                                                                        HorizontalAlignment="Center"
                                                                        Orientation="Horizontal">

                                                                <StackPanel Margin="5,10,0,0">
                                                                    <StackPanel>
                                                                        <TextBlock Margin="3,10,0,0" Text="{Binding ViewModel[Unit]}" />
                                                                        <ComboBox MinWidth="200"
                                                                                  Margin="0,6,0,0"
                                                                                  DisplayMemberBinding="{Binding Display}"
                                                                                  ItemsSource="{Binding ViewModel.Units.Items}"
                                                                                  SelectedItem="{Binding ViewModel.Units.SelectedItem}" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel MinWidth="80"
                                                                            MaxWidth="80"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock x:Name="FocusTarget"
                                                                               Margin="0,10,0,0"
                                                                               Text="{Binding ViewModel[Quantity]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Quantity, Converter={StaticResource TextBoxConverter}}" />
                                                                </StackPanel>

                                                                <StackPanel MinWidth="80"
                                                                            MaxWidth="150"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Price]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Price}" />
                                                                </StackPanel>

                                                                <StackPanel MinWidth="80"
                                                                            MaxWidth="100"
                                                                            Margin="5,10,0,0">
                                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Discount]}" />
                                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Discount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Button Width="50"
                                                                    Height="50"
                                                                    Margin="10,20,0,0"
                                                                    Command="{Binding ViewModel.SubmitCommand}">
                                                                <avalonia:MaterialIcon Margin="-4,0,0,0" Kind="{Binding ViewModel.ModelDetails.Symbol}" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </suki:GlassCard>

                                                    <StackPanel MaxHeight="40"
                                                                Margin="0,5,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">

                                                        <Button MinWidth="100"
                                                                Margin="0,0,0,0"
                                                                Command="{Binding ViewModel.CancelCommand}"
                                                                Content="{Binding ViewModel[CancelButton]}" />
                                                        <Button MinWidth="100"
                                                                Margin="15,0,0,0"
                                                                Command="{Binding ViewModel.SavePrintCommand}"
                                                                Content="{Binding ViewModel[SavePrintButton]}" />
                                                        <Button MinWidth="100"
                                                                Margin="15,0,0,0"
                                                                Command="{Binding ViewModel.SaveCommand}"
                                                                Content="{Binding ViewModel[SaveButton]}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </suki:GlassCard>
                                </TabItem>

                                <TabItem Header="{Binding ViewModel[ExtraFactoringCosts]}">
                                    <suki:GlassCard>
                                        <StackPanel>
                                            <suki:GlassCard Height="30"
                                                            MinWidth="200"
                                                            Padding="0"
                                                            HorizontalAlignment="Left"
                                                            IsVisible="True">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Image Width="25"
                                                           Height="25"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Source="/Assets/InfoIcon.png" />
                                                    <TextBlock Margin="5,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding ViewModel[TotalExtraCostPriceDotted]}" />
                                                    <TextBlock Margin="3,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Text="{Binding ViewModel.TotalPrice}" />
                                                </StackPanel>
                                            </suki:GlassCard>
                                            <ScrollViewer x:Name="SecondaryDataScroller"
                                                          MaxHeight="550"
                                                          Margin="0,10,0,0"
                                                          Padding="5"
                                                          HorizontalScrollBarVisibility="Visible">
                                                <StackPanel x:Name="SecondaryDataGrid" />

                                            </ScrollViewer>

                                            <ScrollViewer Margin="0,0,0,5" HorizontalScrollBarVisibility="Visible">
                                                <DockPanel>
                                                    <suki:GlassCard HorizontalAlignment="Left">
                                                        <WrapPanel>
                                                            <StackPanel MinWidth="200" Margin="10,0">
                                                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Name]}" />
                                                                <TextBox x:Name="FocusScapegoatBox"
                                                                         Margin="0,10,0,0"
                                                                         Text="{Binding ViewModel.ModelCosts.Model.CostName}" />
                                                            </StackPanel>

                                                            <StackPanel Width="200" Margin="10,0">
                                                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Price]}" />
                                                                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelCosts.Model.Price, Converter={StaticResource TextBoxConverter}}" />
                                                            </StackPanel>

                                                            <StackPanel MinWidth="300" Margin="10,0">
                                                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Notes]}" />
                                                                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelCosts.Model.Notes}" />
                                                            </StackPanel>

                                                            <Button Width="50"
                                                                    Height="50"
                                                                    Margin="10,25,0,0"
                                                                    Command="{Binding ViewModel.CostSubmitCommand}">
                                                                <avalonia:MaterialIcon Margin="-4,0,0,0" Kind="{Binding ViewModel.ModelCosts.Symbol}" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </suki:GlassCard>

                                                    <StackPanel MaxHeight="40"
                                                                Margin="0,5,0,0"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">

                                                        <Button MinWidth="100"
                                                                Margin="0,0,0,0"
                                                                Command="{Binding ViewModel.CancelCommand}"
                                                                Content="{Binding ViewModel[CancelButton]}" />
                                                        <Button MinWidth="100"
                                                                Margin="15,0,0,0"
                                                                Command="{Binding ViewModel.SavePrintCommand}"
                                                                Content="{Binding ViewModel[SavePrintButton]}" />
                                                        <Button MinWidth="100"
                                                                Margin="15,0,0,0"
                                                                Command="{Binding ViewModel.SaveCommand}"
                                                                Content="{Binding ViewModel[SaveButton]}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </suki:GlassCard>
                                </TabItem>
                            </TabControl.Items>
                        </TabControl>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</UserControl>