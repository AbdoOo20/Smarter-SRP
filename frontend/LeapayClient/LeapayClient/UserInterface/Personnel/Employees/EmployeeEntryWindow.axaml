<UserControl x:Class="Leapay.Client.UserInterface.Personnel.Employees.EmployeeEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:employees="clr-namespace:Leapay.Client.UserInterface.Personnel.Employees"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="600"
             Height="500"
             d:DataContext="{d:DesignInstance employees:EmployeeEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="500"
             d:DesignWidth="600"
             x:DataType="employees:EmployeeEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="25,40,25,0">

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[EmployeeName]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Name}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DepartmentName]}" />
                <ComboBox Margin="0,10,0,0"
                          ItemsSource="{Binding ViewModel.Departments.Items}"
                          SelectedItem="{Binding ViewModel.Departments.SelectedItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Phone]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Phone}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Email]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Email}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel MinWidth="270">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[OpeningDebtor]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.AccountOpeningDebtor}" />
                </StackPanel>

                <StackPanel MinWidth="270" Margin="10,0,0,0">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[OpeningCredtior]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.AccountOpeningCreditor}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="0,0,0,0"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{Binding ViewModel[CancelButton]}" />
                <Button Margin="15,0,0,0"
                        Command="{Binding ViewModel.SaveCommand}"
                        Content="{Binding ViewModel[SaveButton]}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>