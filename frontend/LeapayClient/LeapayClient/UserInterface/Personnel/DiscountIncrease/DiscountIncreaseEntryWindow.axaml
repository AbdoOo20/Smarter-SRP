<UserControl x:Class="Leapay.Client.UserInterface.Personnel.DiscountIncrease.DiscountIncreaseEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:discountIncrease="clr-namespace:Leapay.Client.UserInterface.Personnel.DiscountIncrease"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="600"
             Height="450"
             d:DataContext="{d:DesignInstance discountIncrease:DiscountIncreaseEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="450"
             d:DesignWidth="600"
             x:DataType="discountIncrease:DiscountIncreaseEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="25,40,25,0">
            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[EmployeeName]}" />
                <ComboBox Margin="0,10,0,0"
                          ItemsSource="{Binding ViewModel.Employees.Items}"
                          SelectedItem="{Binding ViewModel.Employees.SelectedItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Amount]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Amount}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DiscountIncreaseType]}" />
                <ComboBox Margin="0,10,0,0"
                          ItemsSource="{Binding ViewModel.DiscountIncreaseType.Items}"
                          SelectedItem="{Binding ViewModel.DiscountIncreaseType.SelectedItem}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Note]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Note}" />
            </StackPanel>

            <StackPanel Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="0,0,0,0"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{Binding ViewModel[CancelButton]}" />
                <Button Margin="15,0,0,0"
                        Command="{Binding ViewModel.SaveCommand}"
                        Content="{Binding ViewModel[SaveButton]}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>