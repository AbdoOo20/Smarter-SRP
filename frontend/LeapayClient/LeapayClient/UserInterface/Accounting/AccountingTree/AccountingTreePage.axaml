<UserControl
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SizeChanged="OnDataSizeChanged"
    d:DataContext="{d:DesignInstance accountingTree1:AccountingTreePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Leapay.Client.UserInterface.Accounting.AccountingTree.AccountingTreePage"
    x:DataType="accountingTree1:AccountingTreePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:accountingTree1="clr-namespace:Leapay.Client.UserInterface.Accounting.AccountingTree"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Visible">
        <StackPanel Margin="0,0,0,0">
            <StackPanel
                IsVisible="{Binding ViewModel.DataVisibility}"
                VerticalAlignment="Top"
                x:Name="DataGrid" />

            <suki:Loading IsVisible="{Binding ViewModel.IsRefreshing}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>