<UserControl x:Class="Leapay.Client.UserInterface.Sales.SalesReturnInvoice.SellReturnInvoiceEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:salesReturnInvoice="clr-namespace:Leapay.Client.UserInterface.Sales.SalesReturnInvoice"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             d:DataContext="{d:DesignInstance salesReturnInvoice:SellReturnInvoiceEntryWindow,
                                              IsDesignTimeCreatable=True}"
             x:DataType="salesReturnInvoice:SellReturnInvoiceEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ViewModel.RingVisibility}">
            <suki:Loading Width="65"
                          Height="65"
                          Margin="0,0,0,0"
                          HorizontalAlignment="Center"
                          DockPanel.Dock="Top"
                          IsVisible="{Binding ViewModel.IsRefreshing}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       Text="{Binding ViewModel.LoadingTitle}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Text="{Binding ViewModel.LoadingInfo}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ViewModel.UiVisibility}">
            <DockPanel Margin="0,0,0,0" VerticalSpacing="5">
                <StackPanel DockPanel.Dock="Top">
                    <suki:GlassCard Margin="25,0">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNumber]}" />
                                <TextBox MinWidth="150"
                                         Margin="0,10,0,0"
                                         IsReadOnly="True"
                                         Text="{Binding ViewModel.InvoiceNumber}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Date]}" />
                                <DatePicker MinWidth="140"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.Model.Date, Converter={StaticResource DateOffsetConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PaymentType]}" />
                                <ComboBox MinWidth="150"
                                          Margin="0,10,0,0"
                                          ItemsSource="{Binding ViewModel.PaymentTypes.Items}"
                                          SelectedItem="{Binding ViewModel.PaymentTypes.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding ViewModel.SafesVisibility}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Safe]}" />
                                    <ComboBox MinWidth="220"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.Safes.Items}"
                                              SelectedItem="{Binding ViewModel.Safes.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                        </WrapPanel>
                    </suki:GlassCard>
                    <suki:GlassCard Margin="25,5" Padding="12,12">
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Margin="0,5,0,0" Text="{Binding ViewModel[Notes]}" />
                            <TextBox Margin="0,5,0,0"
                                     Text="{Binding ViewModel.Model.Notes}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                    </suki:GlassCard>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Margin="25,3">
                        <suki:GlassCard>
                            <StackPanel>
                                <suki:InfoBar Title="{Binding ViewModel[TotalPrice]}"
                                              MinWidth="200"
                                              Margin="0,0,0,0"
                                              HorizontalAlignment="Left"
                                              IsClosable="False"
                                              IsOpen="True"
                                              Message="{Binding ViewModel.TotalPrice}" />
                                <ScrollViewer x:Name="DataScroller"
                                              MaxHeight="550"
                                              Margin="0,10,0,0"
                                              Padding="5"
                                              HorizontalScrollBarVisibility="Visible">
                                    <StackPanel x:Name="DataGrid" />
                                </ScrollViewer>

                                <ScrollViewer Margin="0,0,0,5" HorizontalScrollBarVisibility="Visible">
                                    <suki:GlassCard>
                                        <WrapPanel>
                                            <StackPanel Margin="10,5"
                                                        HorizontalAlignment="Center"
                                                        Orientation="Horizontal">

                                                <suki:GlassCard>
                                                    <StackPanel Orientation="Horizontal">
                                                        <suki:InfoBar x:Name="ItemInfoBar"
                                                                      Title="{Binding ViewModel[Item]}"
                                                                      Margin="0,0,0,0"
                                                                      FontSize="24"
                                                                      IsClosable="False"
                                                                      IsOpen="True"
                                                                      Message="{Binding ViewModel.SelectedItemStatus}" />

                                                        <Button MinWidth="120"
                                                                Margin="5,0,0,0"
                                                                Command="{Binding ViewModel.SelectItemCommand}"
                                                                Content="{Binding ViewModel[SelectItem]}" />
                                                    </StackPanel>
                                                </suki:GlassCard>

                                            </StackPanel>

                                            <StackPanel Margin="10,5"
                                                        HorizontalAlignment="Center"
                                                        Orientation="Horizontal">

                                                <StackPanel Margin="5,10,0,0">
                                                    <StackPanel>
                                                        <TextBlock Margin="3,10,0,0" Text="{Binding ViewModel[Unit]}" />
                                                        <ComboBox x:Name="FocusTarget"
                                                                  MinWidth="200"
                                                                  Margin="0,6,0,0"
                                                                  DisplayMemberBinding="{Binding Display}"
                                                                  ItemsSource="{Binding ViewModel.Units.Items}"
                                                                  SelectedItem="{Binding ViewModel.Units.SelectedItem}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel MinWidth="80"
                                                            MaxWidth="80"
                                                            Margin="5,10,0,0">
                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Quantity]}" />
                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Quantity, Converter={StaticResource TextBoxConverter}}" />
                                                </StackPanel>

                                                <StackPanel MinWidth="80"
                                                            MaxWidth="80"
                                                            Margin="5,10,0,0">
                                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Price]}" />
                                                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Price, Converter={StaticResource TextBoxConverter}}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Width="50"
                                                    Height="50"
                                                    Margin="10,20,0,0"
                                                    Command="{Binding ViewModel.SubmitCommand}">
                                                <avalonia:MaterialIcon Margin="-4,0,0,0" Kind="{Binding ViewModel.ModelDetails.Symbol}" />
                                            </Button>
                                        </WrapPanel>
                                    </suki:GlassCard>
                                </ScrollViewer>
                            </StackPanel>
                        </suki:GlassCard>


                    </StackPanel>


                    <StackPanel Margin="0,10,25,10"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                Orientation="Horizontal">

                        <StackPanel Orientation="Horizontal">
                            <Button MinWidth="100"
                                    Margin="0,0,0,0"
                                    Command="{Binding ViewModel.CancelCommand}"
                                    Content="{Binding ViewModel[CancelButton]}" />
                            <Button MinWidth="100"
                                    Margin="15,0,0,0"
                                    Command="{Binding ViewModel.SavePrintCommand}"
                                    Content="{Binding ViewModel[SavePrintButton]}" />
                            <Button MinWidth="100"
                                    Margin="15,0,0,0"
                                    Command="{Binding ViewModel.SaveCommand}"
                                    Content="{Binding ViewModel[SaveButton]}" />
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Margin="20,35,0,0"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal" />
                </StackPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>
</UserControl>