<UserControl x:Class="Leapay.Client.UserInterface.Sales.SalesInvoice.SalesInvoiceEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dtoModels1="clr-namespace:Leapay.Client.ClientModels.Dto.DtoModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:salesInvoice="clr-namespace:Leapay.Client.UserInterface.Sales.SalesInvoice"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             d:DataContext="{d:DesignInstance salesInvoice:SalesInvoiceEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="500"
             d:DesignWidth="600"
             x:DataType="salesInvoice:SalesInvoiceEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ViewModel.RingVisibility}">
            <suki:Loading Width="65"
                          Height="65"
                          Margin="0,0,0,0"
                          HorizontalAlignment="Center"
                          DockPanel.Dock="Top"
                          IsVisible="{Binding ViewModel.IsRefreshing}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       Text="{Binding ViewModel.LoadingTitle}" />
            <TextBlock Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       FontSize="18"
                       Text="{Binding ViewModel.LoadingInfo}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding ViewModel.UiVisibility}">
            <DockPanel Margin="0,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <suki:GlassCard Margin="25,0,25,0" Padding="8">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNumber]}" />
                                <TextBox MinWidth="100"
                                         Margin="0,10,0,0"
                                         IsReadOnly="True"
                                         Text="{Binding ViewModel.InvoiceNumber}" />
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0" IsVisible="{Binding ViewModel.SerialNumberVisibility}">
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SerialNumber]}" />
                                <TextBox MinWidth="120"
                                         Margin="0,10,0,0"
                                         Text="{Binding ViewModel.Model.SerialNumber}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Left"
                                        Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Date]}" />
                                <DatePicker MinWidth="140"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            SelectedDate="{Binding ViewModel.Model.Date, Converter={StaticResource DateOffsetConverter}}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.FullVisibility}">
                                <ContentControl Content="{Binding ViewModel.Clients.Content}" />
                            </StackPanel>

                            <StackPanel Margin="5,10,0,0">
                                <TextBlock Text="{Binding ViewModel[PaymentType]}" />
                                <ComboBox MinWidth="150"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ViewModel.PaymentTypes.Items}"
                                          SelectedItem="{Binding ViewModel.PaymentTypes.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="5,10,0,0" IsVisible="False">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[PaymentMethod]}" />
                                    <ComboBox MinWidth="150"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.PaymentMethods.Items}"
                                              SelectedItem="{Binding ViewModel.PaymentMethods.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding ViewModel.SafeVisibility}">

                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Safe]}" />
                                    <ComboBox MinWidth="170"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.Safes.Items}"
                                              SelectedItem="{Binding ViewModel.Safes.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.BankVisibility}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Bank]}" />
                                    <ComboBox MinWidth="170"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.Banks.Items}"
                                              SelectedItem="{Binding ViewModel.Banks.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding ViewModel.FullVisibility}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[StorageType]}" />
                                    <ComboBox MinWidth="150"
                                              Margin="0,5,0,0"
                                              ItemsSource="{Binding ViewModel.StorageTypes.Items}"
                                              SelectedItem="{Binding ViewModel.StorageTypes.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.NormalStoreVisibility}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Store]}" />
                                    <ComboBox MinWidth="230"
                                              Margin="0,5,0,0"
                                              DisplayMemberBinding="{Binding Display}"
                                              ItemsSource="{Binding ViewModel.Stores.Items}"
                                              SelectedItem="{Binding ViewModel.Stores.SelectedItem}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.MarketerStoreVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[MarketerStore]}" />
                                <ComboBox MinWidth="230"
                                          Margin="0,5,0,0"
                                          DisplayMemberBinding="{Binding Display}"
                                          ItemsSource="{Binding ViewModel.MarketerStores.Items}"
                                          SelectedItem="{Binding ViewModel.MarketerStores.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="10,10,0,0" IsVisible="{Binding ViewModel.FullVisibility}">
                                <ContentControl Content="{Binding ViewModel.RepresentativeMarketers.Content}" />
                            </StackPanel>

                            <StackPanel Margin="5,10,0,0">
                                <TextBlock Text="{Binding ViewModel[InvoiceStatus]}" />
                                <ComboBox MinWidth="150"
                                          Margin="0,5,0,0"
                                          ItemsSource="{Binding ViewModel.InvoiceStatus.Items}"
                                          SelectedItem="{Binding ViewModel.InvoiceStatus.SelectedItem}" />
                            </StackPanel>

                            <StackPanel Margin="5,0,0,0" Orientation="Horizontal">
                                <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel[NotesDotted]}" />
                                <TextBox Width="{Binding Bounds.Width, Converter={StaticResource MathConverter}, ConverterParameter='-,180'}"
                                         Margin="3,5,0,0"
                                         Text="{Binding ViewModel.Model.Notes}"
                                         TextWrapping="Wrap" />
                            </StackPanel>

                        </WrapPanel>
                    </suki:GlassCard>
                </StackPanel>

                <StackPanel Margin="25,3,25,0">
                    <suki:GlassCard Padding="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <suki:GlassCard Width="200"
                                                Height="30"
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                IsVisible="True">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Image Width="25"
                                               Height="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Source="/Assets/InfoIcon.png" />
                                        <TextBlock Margin="5,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="{Binding ViewModel[TotalPriceDotted]}" />
                                        <TextBlock Margin="3,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Text="{Binding ViewModel.TotalPrice}" />
                                    </StackPanel>
                                </suki:GlassCard>
                                <StackPanel Margin="10,0,0,15"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ViewModel.FullVisibility}"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[DiscountTypeDotted]}" />
                                    <ComboBox MinWidth="150"
                                              Margin="5,0,0,0"
                                              ItemsSource="{Binding ViewModel.DiscountType.Items}"
                                              SelectedItem="{Binding ViewModel.DiscountType.SelectedItem}" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,15"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ViewModel.FullVisibility}"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,4,0,0" Text="{Binding ViewModel[DiscountDotted]}" />
                                    <TextBox MinWidth="120"
                                             Margin="5,0,0,0"
                                             Text="{Binding ViewModel.Model.Discount}"
                                             TextChanged="OnDiscountTextChanged" />
                                </StackPanel>

                                <StackPanel Margin="10,0,0,15"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[TaxType]}" />
                                    <ComboBox MinWidth="150"
                                              Margin="5,0,0,0"
                                              ItemsSource="{Binding ViewModel.TaxType.Items}"
                                              SelectedItem="{Binding ViewModel.TaxType.SelectedItem}" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,15"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel[TaxDotted]}" />
                                    <TextBox MinWidth="120"
                                             Margin="5,0,0,0"
                                             Text="{Binding ViewModel.Model.Tax}"
                                             TextChanged="OnDiscountTextChanged" />
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer x:Name="DataScroller"
                                          Margin="0,0,0,0"
                                          Padding="3"
                                          HorizontalScrollBarVisibility="Visible">
                                <StackPanel x:Name="DataGrid" />
                            </ScrollViewer>

                            <DockPanel>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <ScrollViewer Margin="0,0,0,5" HorizontalScrollBarVisibility="Visible">
                                        <suki:GlassCard Padding="10">
                                            <StackPanel>
                                                <suki:GlassCard Width="500"
                                                                Padding="5"
                                                                HorizontalAlignment="Left"
                                                                IsVisible="{Binding ViewModel.ShowItemQuantityInStorage}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Image Width="30"
                                                               Height="30"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Source="/Assets/InfoIcon.png" />
                                                        <TextBlock x:Name="ItemQuantityInfoBar"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="14"
                                                                   FontWeight="Bold" />
                                                    </StackPanel>
                                                </suki:GlassCard>
                                                <WrapPanel>
                                                    <StackPanel Margin="10,5" HorizontalAlignment="Center">
                                                        <suki:GlassCard Padding="10" IsOpaque="True">
                                                            <StackPanel Orientation="Horizontal">
                                                                <suki:InfoBar x:Name="ItemInfoBar"
                                                                              Title="{Binding ViewModel[Item]}"
                                                                              Margin="0,0,0,0"
                                                                              FontSize="24"
                                                                              IconSize="7"
                                                                              IsClosable="False"
                                                                              IsOpen="True"
                                                                              Message="{Binding ViewModel.SelectedItemStatus}"
                                                                              Severity="{Binding ViewModel.SelectedItemStatusSeverity, Mode=TwoWay}" />

                                                                <StackPanel Spacing="5">
                                                                    <Button Width="120"
                                                                            Margin="5,0,0,0"
                                                                            Command="{Binding ViewModel.SelectItemCommand}"
                                                                            Content="{Binding ViewModel[SelectItem]}"
                                                                            IsEnabled="{Binding ViewModel.CanAddOrUpdateItems}" />
                                                                    <Button Width="120"
                                                                            Margin="5,0,0,0"
                                                                            Command="{Binding ViewModel.SelectItemsCommand}"
                                                                            Content="{Binding ViewModel[SelectItems]}"
                                                                            IsEnabled="{Binding ViewModel.CanAddOrUpdateItems}" />
                                                                </StackPanel>

                                                            </StackPanel>
                                                        </suki:GlassCard>
                                                    </StackPanel>

                                                    <StackPanel Margin="10,5"
                                                                HorizontalAlignment="Center"
                                                                IsEnabled="{Binding ViewModel.IsAnyItemSelected}"
                                                                Orientation="Horizontal">

                                                        <StackPanel Margin="5,10,0,0">
                                                            <StackPanel>
                                                                <TextBlock Margin="3,10,0,0" Text="{Binding ViewModel[Unit]}" />
                                                                <ComboBox MinWidth="200"
                                                                          Margin="0,6,0,0"
                                                                          DisplayMemberBinding="{Binding Display}"
                                                                          ItemsSource="{Binding ViewModel.Units.Items}"
                                                                          SelectedItem="{Binding ViewModel.Units.SelectedItem}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="5,10,0,0">
                                                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[ItemPriceType]}" />
                                                            <ComboBox Margin="0,6,0,0"
                                                                      ItemsSource="{Binding ViewModel.ItemPriceFilterCombo.Items}"
                                                                      SelectedItem="{Binding ViewModel.ItemPriceFilterCombo.SelectedItem}" />
                                                        </StackPanel>

                                                        <StackPanel MinWidth="80"
                                                                    MaxWidth="150"
                                                                    Margin="5,10,0,0"
                                                                    IsVisible="{Binding ViewModel.FullVisibility}">
                                                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Price]}" />
                                                            <TextBox x:Name="FocusTarget"
                                                                     Margin="0,10,0,0"
                                                                     Text="{Binding ViewModel.ModelDetails.Model.Price}" />
                                                        </StackPanel>

                                                        <StackPanel MinWidth="80"
                                                                    MaxWidth="80"
                                                                    Margin="5,10,0,0">
                                                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Quantity]}" />
                                                            <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Quantity, Converter={StaticResource TextBoxConverter}}" />
                                                        </StackPanel>

                                                        <StackPanel MinWidth="80"
                                                                    MaxWidth="100"
                                                                    Margin="5,10,0,0"
                                                                    IsVisible="{Binding ViewModel.FullVisibility}">
                                                            <TextBlock x:Name="LastFocus"
                                                                       Margin="0,10,0,0"
                                                                       Text="{Binding ViewModel[Discount]}" />
                                                            <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.ModelDetails.Model.Discount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel MinWidth="140"
                                                                    Margin="5,10,0,0"
                                                                    IsVisible="{Binding ViewModel.IsExpireDateVisible}">
                                                            <TextBlock Margin="0,6,0,0" Text="{Binding ViewModel[ExpireDate]}" />
                                                            <ComboBox Margin="0,10,0,0"
                                                                      ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}"
                                                                      SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type dtoModels1:ComboModel}">
                                                                        <TextBlock Text="{Binding Display}" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button Width="50"
                                                            Height="50"
                                                            Margin="10,20,0,0"
                                                            Command="{Binding ViewModel.SubmitCommand}"
                                                            IsEnabled="{Binding ViewModel.CanAddOrUpdateItems}">
                                                        <avalonia:MaterialIcon Margin="-4,0,0,0" Kind="{Binding ViewModel.ModelDetails.Symbol}" />
                                                    </Button>
                                                </WrapPanel>

                                            </StackPanel>
                                        </suki:GlassCard>
                                    </ScrollViewer>
                                </Grid>
                                <StackPanel MaxHeight="40"
                                            Margin="0,5,0,5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Bottom"
                                            Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <Button MinWidth="100"
                                                Margin="0,0,0,0"
                                                Command="{Binding ViewModel.CancelCommand}"
                                                Content="{Binding ViewModel[CancelButton]}" />
                                        <Button MinWidth="100"
                                                Margin="15,0,0,0"
                                                Command="{Binding ViewModel.SavePrintCommand}"
                                                Content="{Binding ViewModel[SavePrintButton]}" />
                                        <Button MinWidth="100"
                                                Margin="15,0,0,0"
                                                Command="{Binding ViewModel.SaveCommand}"
                                                Content="{Binding ViewModel[SaveButton]}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </suki:GlassCard>

                </StackPanel>
            </DockPanel>
        </ScrollViewer>
    </Grid>

</UserControl>