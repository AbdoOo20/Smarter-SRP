<UserControl x:Class="Leapay.Client.UserInterface.Sales.Safes.SafeEntryWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:safes="clr-namespace:Leapay.Client.UserInterface.Sales.Safes"
             Width="600"
             Height="500"
             d:DataContext="{d:DesignInstance safes:SafeEntryWindow,
                                              IsDesignTimeCreatable=True}"
             d:DesignHeight="500"
             d:DesignWidth="600"
             x:DataType="safes:SafeEntryWindow"
             FlowDirection="{Binding ViewModel.FlowDirection}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="25,40,25,0">
            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SafeName]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Name}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,0">
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PaymentType]}" />
                <ComboBox MinWidth="300"
                          Margin="0,10,0,0"
                          ItemsSource="{Binding ViewModel.PaymentType.Items}"
                          SelectedItem="{Binding ViewModel.PaymentType.SelectedItem}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Note]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Note}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel MinWidth="270">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[OpeningDebtor]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.AccountOpeningDebtor}" />
                </StackPanel>

                <StackPanel MinWidth="270" Margin="10,0,0,0">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[OpeningCredtior]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.AccountOpeningCreditor}" />
                </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ViewModel.LossVisibility}">
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[LossPercent]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.LossPercent}" />
            </StackPanel>

            <StackPanel Margin="0,25,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="0,0,0,0"
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{Binding ViewModel[CancelButton]}" />
                <Button Margin="15,0,0,0"
                        Command="{Binding ViewModel.SaveCommand}"
                        Content="{Binding ViewModel[SaveButton]}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>