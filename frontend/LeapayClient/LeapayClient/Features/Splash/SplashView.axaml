<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Leapay.Client.Features.Splash.SplashView"
    x:DataType="splash1:SplashViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:splash1="clr-namespace:Leapay.Client.Features.Splash"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <suki:GlassCard
        HorizontalAlignment="Center"
        Margin="40"
        VerticalAlignment="Top">
        <suki:GroupBox Header="Welcome">
            <StackPanel Classes="HeaderContent">
                <TextBlock Name="TextBlockWithInline">
                    Welcome to Leapay.
                </TextBlock>
            </StackPanel>
        </suki:GroupBox>
    </suki:GlassCard>
</UserControl>