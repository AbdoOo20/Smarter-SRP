<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="Leapay.Client.Features.Dialogs.VmDialogView"
    x:DataType="dialogs:VmDialogViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Leapay.Client.Features.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <suki:GroupBox Header="A ViewModel Dialog">
        <StackPanel Classes="HeaderContent">
            <TextBlock>
                This dialog was created by passing a ViewModel to the dialog system.
            </TextBlock>
            <TextBlock>
                Internally the dialog system then uses the ViewLocator registered in your Application resources to build an appropriate view.
            </TextBlock>
            <HyperlinkButton Content="The source for our implementation of a ViewLocator that makes this possible can be found here." NavigateUri="https://github.com/kikipoulet/SukiUI/blob/main/SukiUI.Demo/Common/ViewLocator.cs" />
            <Button
                Command="{Binding CloseDialogCommand}"
                Content="Close"
                HorizontalContentAlignment="Center" />
        </StackPanel>
    </suki:GroupBox>
</UserControl>