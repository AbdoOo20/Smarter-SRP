<Page
    x:Class="SmartiErpWin.Client.UserInterface.Accounting.AccountingTree.AccountingTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance accountingTree:AccountingTreePage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SizeChanged="OnDataSizeChanged"
    mc:Ignorable="d"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:accountingTree="clr-namespace:SmartiErpWin.Client.UserInterface.Accounting.AccountingTree">
    <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Visible">
        <StackPanel Margin="0, 0, 0, 0">
            <StackPanel x:Name="DataGrid" VerticalAlignment="Top"
                        Visibility="{Binding ViewModel.DataVisibility}" />

            <mah:ProgressRing IsActive="{Binding ViewModel.IsRefreshing}" 
                              Visibility="{Binding ViewModel.RingVisibility}"
                              HorizontalAlignment="Center"
                              Margin="0, 150, 0, 0"
                              VerticalAlignment="Center"
                              Width="35" Height="35"/>
        </StackPanel>
    </ui:DynamicScrollViewer>
</Page>