<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="700"
    MaxHeight="740"
    MaxWidth="1000"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1000"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance groups:GroupEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="740"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Management.Groups.GroupEntryWindow"
    x:Name="GroupEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:groups="clr-namespace:SmartiErpWin.Client.UserInterface.Management.Groups"
    xmlns:inpc="clr-namespace:SmartiErpWin.Client.Wrappers.INPC"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <prefabs:RefreshPrefab
            Grid.Row="1"
            HorizontalAlignment="Center"
            IsRefreshing="{Binding ViewModel.IsRefreshing}"
            LoadingInfo="{Binding ViewModel.LoadingInfo}"
            LoadingTitle="{Binding ViewModel.LoadingTitle}"
            VerticalAlignment="Center"
            Visibility="{Binding ViewModel.RingVisibility}" />

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar" />
        <StackPanel
            Grid.Row="1"
            Margin="15,0"
            Visibility="{Binding ViewModel.UiVisibility}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel[GroupName]}" />
                <TextBox
                    Margin="8,0,0,0"
                    Text="{Binding ViewModel.Model.Name}"
                    Width="200" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">

                <StackPanel>
                    <ui:Card Margin="0,10,0,0" Padding="5">
                        <StackPanel>
                            <ui:TextBox
                                Margin="5"
                                PlaceholderText="{Binding ViewModel[SearchBar]}"
                                TextChanged="OnSearchChanged" />
                            <ui:DynamicScrollViewer Height="480" VerticalScrollBarVisibility="Visible">
                                <ui:ListView
                                    ItemsSource="{Binding ViewModel.SearchedRoles}"
                                    SelectedItem="{Binding ViewModel.SelectedRole}"
                                    Width="250">
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type inpc:ObservableSelectableRole}">
                                            <StackPanel Margin="5" Orientation="Horizontal">
                                                <TextBlock Text="{Binding IsEnabledText}" />
                                                <TextBlock Margin="10,0,0,0" Text="{Binding WindowName, Converter={StaticResource LocaleConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <b:Interaction.Triggers>
                                        <b:EventTrigger EventName="MouseDoubleClick">
                                            <b:InvokeCommandAction Command="{Binding ViewModel.SwitchRoleCheckCommand}" />
                                        </b:EventTrigger>
                                    </b:Interaction.Triggers>
                                </ui:ListView>
                            </ui:DynamicScrollViewer>
                            <StackPanel HorizontalAlignment="Center">
                                <Button
                                    Command="{Binding ViewModel.RoleSelectionCommand}"
                                    Content="{Binding ViewModel.RoleSelectionState}"
                                    Margin="5"
                                    Width="100" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <StackPanel HorizontalAlignment="Left" Margin="10,0,0,0">
                    <ui:Card
                        Margin="0,10,0,0"
                        Padding="10"
                        Visibility="{Binding ViewModel.SelectedItemVisibility}">
                        <DockPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                HorizontalAlignment="Left"
                                Margin="0,3,0,0"
                                Text="{Binding ViewModel.SelectedRole.WindowName, Converter={StaticResource LocaleConverter}}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button
                                    Command="{Binding ViewModel.SelectionCommand}"
                                    Content="{Binding ViewModel.SelectionState}"
                                    Margin="0,0,10,0" />
                            </StackPanel>
                        </DockPanel>
                    </ui:Card>

                    <ui:DynamicScrollViewer
                        Margin="0,10,0,0"
                        MaxHeight="470"
                        MinHeight="470"
                        VerticalScrollBarVisibility="Visible">
                        <ui:VirtualizingItemsControl
                            ItemsSource="{Binding ViewModel.SelectedRole.Keys}"
                            Margin="0,0,0,0"
                            MaxWidth="700">
                            <ui:VirtualizingItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type inpc:ObservableRoleKey}">
                                    <ui:CardControl
                                        Command="{Binding ViewModel.SwitchCheckCommand, ElementName=GroupEntry}"
                                        CommandParameter="{Binding .}"
                                        HorizontalAlignment="Left"
                                        Margin="3">
                                        <StackPanel Margin="0" Orientation="Horizontal">
                                            <CheckBox
                                                Checked="OnStateChanged"
                                                IsChecked="{Binding IsChecked}"
                                                Unchecked="OnStateChanged" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Text="{Binding KeyName, Converter={StaticResource LocaleConverter}}"
                                                TextWrapping="WrapWithOverflow"
                                                Width="140" />
                                        </StackPanel>
                                    </ui:CardControl>
                                </DataTemplate>
                            </ui:VirtualizingItemsControl.ItemTemplate>
                        </ui:VirtualizingItemsControl>
                    </ui:DynamicScrollViewer>
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Margin="0,0,15,0"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding ViewModel.CancelCommand}"
                                Content="{Binding ViewModel[CancelButton]}"
                                Margin="0,0,0,0"
                                Width="80" />
                            <Button
                                Command="{Binding ViewModel.SaveCommand}"
                                Content="{Binding ViewModel[SaveButton]}"
                                Margin="15,0,0,0"
                                Width="80" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>