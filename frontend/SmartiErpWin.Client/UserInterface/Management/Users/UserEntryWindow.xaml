<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="420"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="600"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance users:UserEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="420"
    d:DesignWidth="600"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Management.Users.UserEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:users="clr-namespace:SmartiErpWin.Client.UserInterface.Management.Users"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar" />

        <StackPanel Grid.Row="0" Margin="25,40,25,0">
            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Name]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Name}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Phone]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Phone}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Password]}" />
                <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Password}" />
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Group]}" />
                <ComboBox
                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}"
                    Margin="0,10,0,0"
                    MinWidth="200"
                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                Orientation="Horizontal">
                <Button
                    Command="{Binding ViewModel.CancelCommand}"
                    Content="{Binding ViewModel[CancelButton]}"
                    Margin="0,0,0,0" />
                <Button
                    Command="{Binding ViewModel.SaveCommand}"
                    Content="{Binding ViewModel[SaveButton]}"
                    Margin="15,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>