<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="600"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="600"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance operationWindows:ClientRepresentativeReceiptEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="600"
    d:DesignWidth="600"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Financial.FinancingOperations.OperationWindows.ClientRepresentativeReceiptEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:operationWindows="clr-namespace:SmartiErpWin.Client.UserInterface.Financial.FinancingOperations.OperationWindows"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar" />

        <StackPanel Grid.Row="0" Margin="25,40,25,0">
            <DockPanel Margin="0,10,0,0">
                <StackPanel MinWidth="270" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Date]}" />
                    <DatePicker Margin="0,10,0,0" SelectedDate="{Binding ViewModel.Model.Date}" />
                </StackPanel>

                <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.SerialNumberVisibility}">
                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[SerialNumber]}" />
                    <TextBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.SerialNumber}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,10,0,0">

                <StackPanel Margin="0,0">
                    <prefabs:SecAutoSuggestPrefab
                        ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}"
                        Margin="0,10,0,0"
                        MinComboWidth="270"
                        OnSelectionChanged="MarketerSelected"
                        SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                        TitleText="{Binding ViewModel[MarketerName]}" />
                </StackPanel>

                <StackPanel Margin="10,0">
                    <prefabs:QuaAutoSuggestPrefab
                        ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}"
                        Margin="0,10,0,0"
                        MinComboWidth="270"
                        SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}"
                        TitleText="{Binding ViewModel[ClientName]}" />
                </StackPanel>
                <!--
                <StackPanel >
                    <TextBlock Text="{Binding ViewModel[MarketerName]}"  Margin="0, 10, 0, 0"/>
                    <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                              SelectionChanged="MarketerSelected"
                              MinWidth="270">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="10, 10, 0, 0">
                    <TextBlock Text="{Binding ViewModel[ClientName]}"/>
                    <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}" Margin="0, 10, 0, 0"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}"
                              MinWidth="270">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                -->
            </DockPanel>


            <DockPanel Margin="0,10,0,0">
                <StackPanel MinWidth="270">
                    <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[MarketerPercentage]}" />
                    <ui:NumberBox Margin="0,10,0,0" Text="{Binding ViewModel.ClientPercentage}" />
                </StackPanel>

                <StackPanel Margin="10,10,0,0">
                    <TextBlock Text="{Binding ViewModel[SafeName]}" />
                    <ComboBox
                        ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}"
                        Margin="0,10,0,0"
                        SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Amount]}" />
                <ui:NumberBox Margin="0,10,0,0" Text="{Binding ViewModel.Model.Amount}" />
            </StackPanel>

            <StackPanel>
                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[Notes]}" />
                <TextBox
                    Margin="0,10,0,0"
                    MaxHeight="120"
                    MinHeight="120"
                    MinLines="1"
                    Text="{Binding ViewModel.Model.Note}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Margin="0,25,0,0"
                Orientation="Horizontal">
                <Button
                    Command="{Binding ViewModel.CancelCommand}"
                    Content="{Binding ViewModel[CancelButton]}"
                    Margin="0,0,0,0" />
                <Button
                    Command="{Binding ViewModel.SaveCommand}"
                    Content="{Binding ViewModel[SaveButton]}"
                    Margin="15,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>