<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Financial.FinancingOperations.OperationWindows.DiscountItemFinanceEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:operationWindows="clr-namespace:SmartiErpWin.Client.UserInterface.Financial.FinancingOperations.OperationWindows"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="600"
    Height="650"
    d:DataContext="{d:DesignInstance operationWindows:DiscountItemFinanceEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="650"
    d:DesignWidth="600"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    FlowDirection="{Binding ViewModel.FlowDirection}">
    <ui:DynamicScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar
                x:Name="TitleBar"
                Title="{Binding ViewModel.ApplicationTitle}"
                Grid.Row="0"
                CloseWindowByDoubleClickOnIcon="True"
                ShowMinimize="False"
                ShowMaximize="False" />

            <StackPanel Grid.Row="0" Margin="25, 40, 25, 0">

                <DockPanel Margin="0, 10, 0, 0">
                    <!--<StackPanel >
                        <TextBlock Text="{Binding ViewModel[MarketerName]}"  Margin="0, 10, 0, 0"/>
                        <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                  SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                  SelectionChanged="MarketerSelected"
                  MinWidth="270">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>-->

                    <StackPanel Margin="0, 0">
                        <prefabs:SecAutoSuggestPrefab ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                               SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                               TitleText="{Binding ViewModel[MarketerName]}"
                                                   MinComboWidth="270"
                                                   OnSelectionChanged="MarketerSelected"/>
                    </StackPanel>

                    <StackPanel Margin="10, 0">
                        <prefabs:QuaAutoSuggestPrefab ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[5]}" Margin="0, 10, 0, 0"
                               SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[5]}"
                               TitleText="{Binding ViewModel[ClientName]}" MinComboWidth="270" />
                    </StackPanel>

                    <!--<StackPanel Margin="10, 10, 0, 0">
                        <TextBlock Text="{Binding ViewModel[ClientName]}"/>
                        <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[5]}" Margin="0, 10, 0, 0"
                  SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[5]}"
                  MinWidth="270">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>-->

                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel MinWidth="270">
                        <TextBlock Text="{Binding ViewModel[Amount]}" Margin="0, 10, 0, 0"/>
                        <ui:NumberBox Text="{Binding ViewModel.Model.Amount}" Margin="0, 10, 0, 0"/>
                    </StackPanel>
                
                    <StackPanel MinWidth="270"
                                Margin="10, 0, 0, 0">
                        <TextBlock Text="{Binding ViewModel[Quantity]}" Margin="0, 10, 0, 0"/>
                        <ui:NumberBox Text="{Binding ViewModel.Model.Quantity}" Margin="0, 10, 0, 0"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Margin="0, 10, 0, 0">
                    <prefabs:AutoSuggestPrefab ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}"
                                               Margin="0, 10, 0, 0"
                                               SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}"
                                               TitleText="{Binding ViewModel[Item]}"
                                               OnSelectionChanged="ItemSelected" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    
                    <StackPanel>
                        <TextBlock Text="{Binding ViewModel[Unit]}" Margin="0, 10, 0, 0" />
                        <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[3]}" Margin="0, 10, 0, 0"
                                  SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[3]}"
                                  MinWidth="270">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                    <TextBlock Text="{Binding Display}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>


                    <StackPanel Margin="10, 10, 0, 0">
                        <TextBlock Text="{Binding ViewModel[ExpireDate]}" Margin="0, 0, 0, 0" />
                        <DatePicker
                            MinWidth="270"
                            SelectedDate="{Binding ViewModel.Model.ExpireDate, Mode=TwoWay}"
                            Margin="0, 10, 0, 0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0, 10, 0, 0">
                    <TextBlock Text="{Binding ViewModel[Notes]}" Margin="0, 10, 0, 0" />
                    <TextBox Text="{Binding ViewModel.Model.Note}"
                             Margin="0, 10, 0, 0"
                             TextWrapping="Wrap"
                             MinHeight="100"
                             MinLines="1"
                             MaxHeight="100"/>
                </StackPanel>

                <StackPanel Visibility="{Binding ViewModel.SerialNumberVisibility}">
                    <TextBlock Text="{Binding ViewModel[SerialNumber]}" Margin="0, 10, 0, 0" />
                    <TextBox Text="{Binding ViewModel.Model.SerialNumber}" Margin="0, 10, 0, 0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0, 25, 0, 0" HorizontalAlignment="Center">
                    <Button Content="{Binding ViewModel[CancelButton]}" Margin="0, 0, 0, 0"
                            Command="{Binding ViewModel.CancelCommand}" />
                    <Button Content="{Binding ViewModel[SaveButton]}"
                            Command="{Binding ViewModel.SaveCommand}" Margin="15, 0, 0, 0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ui:DynamicScrollViewer>
</ui:FluentWindow>