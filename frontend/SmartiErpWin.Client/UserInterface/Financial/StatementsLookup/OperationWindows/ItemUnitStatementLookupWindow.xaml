<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Financial.StatementsLookup.OperationWindows.ItemUnitStatementLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:operationWindows="clr-namespace:SmartiErpWin.Client.UserInterface.Financial.StatementsLookup.OperationWindows"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="600"
    Height="630"
    d:DataContext="{d:DesignInstance operationWindows:ItemUnitStatementLookupWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="630"
    d:DesignWidth="600"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    FlowDirection="{Binding ViewModel.FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True"
            ShowMinimize="False"
            ShowMaximize="False"/>
        
        <StackPanel Grid.Row="0" Margin="25, 40, 25, 0">
            <ui:Card Margin="0, 20, 0, 0">
                <DockPanel >
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding ViewModel[StartDate]}" Margin="0, 0, 0, 0" HorizontalAlignment="Center"/>
                        <DatePicker MinWidth="220"
                                    Margin="0, 10, 0, 0"
                                    HorizontalAlignment="Left"
                                    SelectedDate="{Binding ViewModel.Model.FromDate}"/>   
                    </StackPanel>
                
                    <StackPanel HorizontalAlignment="Right" Orientation="Vertical">
                        <TextBlock Text="{Binding ViewModel[EndDate]}" Margin="0, 0, 0, 0" HorizontalAlignment="Center"/>
                        <DatePicker MinWidth="220"
                                    Margin="0, 10, 0, 0"
                                    HorizontalAlignment="Left"
                                    SelectedDate="{Binding ViewModel.Model.ToDate}"/>  
                    </StackPanel>
                </DockPanel>     
            </ui:Card>
            
            <StackPanel>
                <TextBlock Text="{Binding ViewModel[Store]}" Margin="0, 10, 0, 0"/>
                <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}" Margin="0, 10, 0, 0"
                          SelectionChanged="ComboPrefabOnOnSelectionChanged"
                          SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <StackPanel>
                <TextBlock Text="{Binding ViewModel[Item]}" Margin="0, 10, 0, 0"/>
                <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                          SelectionChanged="ComboPrefabOnOnSelectionChanged"
                          SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            
            <StackPanel>
                <TextBlock Text="{Binding ViewModel[Unit]}" Margin="0, 10, 0, 0"/>
                <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}" Margin="0, 10, 0, 0"
                          SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <ui:Card Margin="0, 10, 0, 0">
                <CheckBox Content="{Binding ViewModel[CollectBeforeEndDateNote]}"
                          IsChecked="{Binding ViewModel.Model.CollecttTheQuntitiesBeforTime}"/>
            </ui:Card>
            
            <ui:InfoBar IsOpen="True" Margin="0, 10, 0, 0"
                        Title="{Binding ViewModel[Result]}"
                        Message="{Binding ViewModel.ResultText}"
                        IsClosable="False"/>

            <StackPanel Orientation="Horizontal" Margin="0, 35, 0, 0" HorizontalAlignment="Center">
                <Button Content="{Binding ViewModel[CloseButton]}" Margin="0, 0, 0, 0"
                        Command="{Binding ViewModel.CancelCommand}"/>
                <Button Content="{Binding ViewModel[ReleaseButton]}"
                        Command="{Binding ViewModel.SaveCommand}" Margin="15, 0, 0, 0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>