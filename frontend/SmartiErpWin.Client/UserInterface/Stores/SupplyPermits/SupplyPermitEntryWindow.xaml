<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Stores.SupplyPermits.SupplyPermitEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:supplyPermits="clr-namespace:SmartiErpWin.Client.UserInterface.Stores.SupplyPermits"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="900"
    Height="800"
    d:DesignWidth="900"
    d:DesignHeight="800"
    d:DataContext="{d:DesignInstance supplyPermits:SupplyPermitEntryWindow,
                                     IsDesignTimeCreatable=True}"


    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    FlowDirection="{Binding ViewModel.FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <prefabs:RefreshPrefab Grid.Row="1" Visibility="{Binding ViewModel.RingVisibility}"
                               LoadingInfo="{Binding ViewModel.LoadingInfo}"
                               LoadingTitle="{Binding ViewModel.LoadingTitle}"
                               IsRefreshing="{Binding ViewModel.IsRefreshing}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <ui:TitleBar DockPanel.Dock="Top"
                     x:Name="TitleBar"
                     Title="{Binding ViewModel.ApplicationTitle}"
                     Grid.Row="0"
                     CloseWindowByDoubleClickOnIcon="True"
                     ShowMinimize="True"
                     ShowMaximize="False"/>
        
            <ui:DynamicScrollViewer Grid.Row="1" Visibility="{Binding ViewModel.UiVisibility}">
        
        <DockPanel Margin="0, 0, 0, 0">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0, 0, 0, 0">
                                <TextBlock Text="{Binding ViewModel[Supplier]}" Margin="0, 10, 0, 0"/>
                                <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                                          SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                                          MinWidth="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                            <TextBlock Text="{Binding Display}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        <StackPanel Margin="25, 0, 0, 0">
                            <TextBlock Text="{Binding ViewModel[Date]}" Margin="0, 10, 0, 0"/>
                            <DatePicker
                                MinWidth="200"
                                SelectedDate="{Binding ViewModel.Model.DtoSupplyPermit.Date}" Margin="0, 10, 0, 0"/>
                        </StackPanel>
                        <StackPanel Margin="25, 0, 0, 0">
                            <TextBlock Text="{Binding ViewModel[Store]}" Margin="0, 10, 0, 0"/>
                            <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}" Margin="0, 10, 0, 0"
                                      SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}"
                                      MinWidth="200">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" />
                </StackPanel>
            </StackPanel>
            
            <StackPanel Margin="25">
                <ui:Card>
                    <StackPanel>

                        <ui:DynamicScrollViewer x:Name="DataScroller" Padding="5" Margin="0, 10, 0, 0"
                                                HorizontalScrollBarVisibility="Visible" MaxHeight="550">
                            <StackPanel x:Name="DataGrid" />
                        </ui:DynamicScrollViewer>
                        
                        <supplyPermits:SupplyPermitDetailsEntryWindow x:Name="EntryState"/>

                    </StackPanel>
                </ui:Card>

                    <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 10"
                            HorizontalAlignment="Center"  DockPanel.Dock="Bottom">

                    <ui:Card Margin="10, 0, 0, 0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding ViewModel[CancelButton]}" Margin="0, 0, 0, 0"
                                    Command="{Binding ViewModel.CancelCommand}"/>
                            <Button Content="{Binding ViewModel[SaveButton]}"
                                    Command="{Binding ViewModel.SaveCommand}" Margin="15, 0, 0, 0"/>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="20, 35, 0, 0" HorizontalAlignment="Left" />
            </StackPanel>
        </DockPanel>
    </ui:DynamicScrollViewer>

    </Grid>
</ui:FluentWindow>