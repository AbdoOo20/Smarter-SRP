<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Stores.Items.ItemsEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:items="clr-namespace:SmartiErpWin.Client.UserInterface.Stores.Items"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="900"
    Height="800"
    d:DataContext="{d:DesignInstance items:ItemsEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="800"
    d:DesignWidth="900"

    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    FlowDirection="{Binding ViewModel.FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <prefabs:RefreshPrefab Grid.Row="1" Visibility="{Binding ViewModel.RingVisibility}"
                               LoadingInfo="{Binding ViewModel.LoadingInfo}"
                               LoadingTitle="{Binding ViewModel.LoadingTitle}"
                               IsRefreshing="{Binding ViewModel.IsRefreshing}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        
        <ui:TitleBar DockPanel.Dock="Top"
                     x:Name="TitleBar"
                     Title="{Binding ViewModel.ApplicationTitle}"
                     Grid.Row="0"
                     CloseWindowByDoubleClickOnIcon="True"
                     ShowMinimize="True"
                     ShowMaximize="False"/>
            <ui:DynamicScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Visible"
                                    Visibility="{Binding ViewModel.UiVisibility}">
        
        <DockPanel Margin="0, 0, 0, 0">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Text="{Binding ViewModel[Category]}" Margin="0, 10, 0, 0"/>
                            <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                                      SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                                      MinWidth="200">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                        <TextBlock Text="{Binding Display}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="10, 0, 0, 0">
                            <TextBlock Text="{Binding ViewModel[LatinName]}" Margin="0, 10, 0, 0"/>
                            <TextBox
                                MinWidth="200"
                                Text="{Binding ViewModel.Model.DtoItem.Name}" Margin="0, 10, 0, 0"/>
                        </StackPanel>
                        <StackPanel Margin="10, 0, 0, 0">
                            <TextBlock Text="{Binding ViewModel[Barcode]}" Margin="0, 10, 0, 0"/>
                            <TextBox
                                MinWidth="200"
                                Text="{Binding ViewModel.Model.DtoItem.Barcode}" Margin="0, 10, 0, 0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">

                        <StackPanel Margin="0, 20, 0, 0">
                            <TextBlock Text="{Binding ViewModel[ItemSellingPrice]}" Margin="0, 0, 0, 5"/>
                            <TextBox Text="{Binding ViewModel.Model.DtoItem.Price}"
                                     MinWidth="200" Margin="0, 0, 0, 0"/>
                        </StackPanel>
                        
                        <!--<StackPanel Margin="10, 20, 0, 0">
                            <TextBlock Text="{Binding ViewModel[PhotoLink]}" Margin="0, 0, 0, 5"/>
                            <TextBox Text="{Binding ViewModel.Model.DtoItem.Photo}"
                                     MinWidth="200" MaxWidth="200" Margin="0, 0, 0, 0"/>
                        </StackPanel>-->
                        
                        <!--<ui:Card MinWidth="300" MaxHeight="83"  Margin="10, 20, 0, 0">
                            <StackPanel Orientation="Horizontal" Margin="0, -10, 0, 0">
                                <StackPanel Margin="0, 0, 0, 0">
                                    <TextBlock Text="{Binding ViewModel[ExpireDate]}" Margin="0, 0, 0, 0"/>
                                    <DatePicker
                                        MinWidth="150"
                                        SelectedDate="{Binding ViewModel.SelectedExpireDate, Mode=TwoWay}"
                                        Margin="0, 5, 0, 0"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Margin="25, 0, 0, 0">
                                    <TextBlock Text="{Binding ViewModel[IsExpirable]}" Margin="0, 0, 0, 0"/>
                                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.IsExpirable}"
                                                     MinWidth="80" Margin="10, 13, 0, 0"/>
                                </StackPanel>
                            </StackPanel>
                            
                        </ui:Card>-->
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"  Margin="0, 0, 38, 0">
                            <StackPanel />
                            <StackPanel Margin="25, 0, 0, 0" Visibility="Collapsed">
                                <TextBlock Text="{Binding ViewModel[Photo]}" Margin="0, 10, 0, 0"/>
                                <TextBox
                                    MinWidth="250"
                                    Text="{Binding ViewModel.Model.DtoItem.Photo}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" />
                <StackPanel HorizontalAlignment="Center" />

            </StackPanel>
            
            <StackPanel Margin="25">
                <ui:Card>
                    <StackPanel>

                        <ui:DynamicScrollViewer x:Name="DataScroller" Padding="5" Margin="0, 10, 0, 0"
                                                HorizontalScrollBarVisibility="Visible"  MaxWidth="750" MaxHeight="550">
                            <StackPanel x:Name="DataGrid" />
                        </ui:DynamicScrollViewer>
                        
                        <items:ItemsUnitEntryWindow x:Name="EntryState"/>
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 10"
                            HorizontalAlignment="Center"  DockPanel.Dock="Bottom">

                    <ui:Card Margin="10, 0, 0, 0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding ViewModel[CancelButton]}" Margin="0, 0, 0, 0"
                                    Command="{Binding ViewModel.CancelCommand}"/>
                            <Button Content="{Binding ViewModel[SaveButton]}"
                                    Command="{Binding ViewModel.SaveCommand}" Margin="15, 0, 0, 0"/>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="20, 35, 0, 0" HorizontalAlignment="Left" />
            </StackPanel>
        </DockPanel>
    </ui:DynamicScrollViewer>

    </Grid>
</ui:FluentWindow>