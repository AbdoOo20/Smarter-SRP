<UserControl
    x:Class="SmartiErpWin.Client.UserInterface.Stores.Items.ItemsUnitEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:items="clr-namespace:SmartiErpWin.Client.UserInterface.Stores.Items"
    Width="750"
    Height="100"
    d:DesignHeight="100"
    d:DesignWidth="750"
    d:DataContext="{d:DesignInstance items:ItemsUnitEntryWindow,
                                     IsDesignTimeCreatable=True}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"

    mc:Ignorable="d"
    FlowDirection="RightToLeft">

    <StackPanel Margin="10, 5" Orientation="Horizontal" HorizontalAlignment="Center">
        <StackPanel MinWidth="200" Margin="10, 0">
            <TextBlock Text="{Binding ViewModel[Unit]}" Margin="0, 10, 0, 0" />
            <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                      SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                      x:Name="FocusScapegoatCombo">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="10, 0, 0, 0" MinWidth="150">
            <TextBlock Text="{Binding ViewModel[TransferRate]}" Margin="0, 10, 0, 0" />
            <TextBox Text="{Binding ViewModel.Model.TransferRate, Converter={StaticResource TextBoxConverter}}" Margin="0, 10, 0, 0" />
        </StackPanel>
 
        <StackPanel Margin="10, 20, 0, 0" MinWidth="150">
            <ui:Card MaxHeight="100" Margin="0, 10, 0, 0" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ViewModel[Primary]}" />
                    <ui:ToggleSwitch IsChecked="{Binding ViewModel.Model.IsPrimary}" Margin="15, 0, 0, 0" />
                </StackPanel>
            </ui:Card>

        </StackPanel>

        <Button Width="45" Height="45" Margin="10, 20, 0, 0"
                Command="{Binding ViewModel.SaveCommand}">
            <ui:SymbolIcon Symbol="{Binding ViewModel.Symbol}" />
        </Button>
    </StackPanel>

</UserControl>