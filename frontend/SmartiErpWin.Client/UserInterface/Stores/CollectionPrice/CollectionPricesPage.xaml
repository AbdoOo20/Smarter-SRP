<Page
    x:Class="SmartiErpWin.Client.UserInterface.Stores.CollectionPrice.CollectionPricesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance items:ItemsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    SizeChanged="OnDataSizeChanged"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:items="clr-namespace:SmartiErpWin.Client.UserInterface.Stores.Items"
    mc:Ignorable="d">

    <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Visible">
        <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal"   DockPanel.Dock="Top"
                            HorizontalAlignment="Center">
                <prefabs:ToolbarPrefab x:Name="ToolbarPrefab"
                                       ActionsEnabled="{Binding ViewModel.ActionsEnabled}"
                                       SearchBar="{Binding ViewModel[SearchBar]}"
                                       SearchText="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       SearchButton="{Binding ViewModel[SearchButton]}"
                                       RefreshCommand="{Binding ViewModel.RefreshCommand}"
                                          
                                        
                                       PrimaryButtonColour="{Binding ViewModel.PrimaryButtonColour}"
                                       SecondaryButtonColour="{Binding ViewModel.SecondaryButtonColour}"
                                       
                                       AddVisibility="Visible"
                                       NewButton="{Binding ViewModel[SaveButton]}"
                                       AddCommand="{Binding ViewModel.AddCommand}"
                                       
                                       PrintVisibility="Visible"
                                       PrintText="{Binding ViewModel[SettingsButton]}"
                                       PrintCommand="{Binding ViewModel.PrintCommand}"
                                       />
                <!--ViewModel.PrintVisibility-->
            </StackPanel>
            <mah:ProgressRing IsActive="{Binding ViewModel.IsRefreshing}" Visibility="{Binding ViewModel.RingVisibility}"
                                 HorizontalAlignment="Center" Margin="0, 50, 0, 0" DockPanel.Dock="Top"
                                 Width="35" Height="35"/>

            <StackPanel x:Name="dataGridHolder"
                Margin="0, 25, 0, 0" 
                Visibility="{Binding ViewModel.DataVisibility}"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch">

                <ui:DataGrid x:Name="dataGrid" 
                             IsEnabled="{Binding ViewModel.IsEnabled}"
                        AutoGenerateColumns="False" 
                        Width="600"
                        Margin="10 5" 
                        CanUserAddRows="False"
                        HorizontalContentAlignment="Stretch"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ItemsSource="{Binding ViewModel.Items,  Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn CanUserSort="False" Header="{Binding ViewModel[Name]}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn CanUserSort="False" Header="{Binding ViewModel[Price]}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:TextBox Width="150" Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TextBoxConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{Binding ViewModel[Barcode]}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Barcode}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </ui:DataGrid>


            </StackPanel>
        </DockPanel>
    </ui:DynamicScrollViewer>
</Page>