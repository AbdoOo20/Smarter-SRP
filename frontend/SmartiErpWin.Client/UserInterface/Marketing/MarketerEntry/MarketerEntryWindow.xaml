<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Marketing.MarketerEntry.MarketerEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:marketerEntry="clr-namespace:SmartiErpWin.Client.UserInterface.Marketing.MarketerEntry"
    xmlns:dtos="clr-namespace:Fly.Shared.Modules.PurchaseAndSales.Dtos.Misc;assembly=Fly.Shared"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviours="clr-namespace:SmartiErpWin.Client.Behaviours"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="600"
    Height="740"
    d:DataContext="{d:DesignInstance marketerEntry:MarketerEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="740"
    d:DesignWidth="600"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    FlowDirection="{Binding ViewModel.FlowDirection}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True"
            ShowMinimize="False"
            ShowMaximize="False"/>
        
        <TabControl Grid.Row="1" Margin="10" VerticalAlignment="Top" VerticalContentAlignment="Top">
            <TabControl.Items>
                <TabItem Header="{Binding ViewModel[MarketerInfo]}">
                    <ui:Card MinHeight="550">
                        <StackPanel Margin="25, 0, 25, 25">
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[MarketerName]}" Margin="0, 0, 0, 0"/>
                                <TextBox Text="{Binding ViewModel.Model.Name}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
            
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[Phone]}" Margin="0, 10, 0, 0"/>
                                <TextBox Text="{Binding ViewModel.Model.Phone}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
            
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[Email]}" Margin="0, 10, 0, 0"/>
                                <TextBox Text="{Binding ViewModel.Model.Email}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
            
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[MarketerPercent]}" Margin="0, 10, 0, 0"/>
                                <TextBox Text="{Binding ViewModel.Model.Percentage}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
                            
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[MarketerSalary]}" Margin="0, 10, 0, 0"/>
                                <TextBox Text="{Binding ViewModel.Model.Salary}" Margin="0, 10, 0, 0"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal">
                                <StackPanel MinWidth="245">
                                    <TextBlock Text="{Binding ViewModel[OpeningDebtor]}" Margin="0, 10, 0, 0"/>
                                    <ui:NumberBox Text="{Binding ViewModel.Model.AccountOpeningDebtor}" Margin="0, 10, 0, 0"/>
                                </StackPanel>
                
                                <StackPanel MinWidth="245"
                                            Margin="10, 0, 0, 0">
                                    <TextBlock Text="{Binding ViewModel[OpeningCreditor]}" Margin="0, 10, 0, 0"/>
                                    <ui:NumberBox Text="{Binding ViewModel.Model.AccountOpeningCreditor}" Margin="0, 10, 0, 0"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <ui:Card Padding="10" Margin="0, 10, 0, 0">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding ViewModel.Model.IsRepresentative}"/>
                                    <TextBlock Text="{Binding ViewModel[MarketerIsARepresentative]}" Margin="5, 6, 0, 0"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ui:Card>
                </TabItem>
                
                <TabItem Header="{Binding ViewModel[MarketerClients]}" VerticalContentAlignment="Top"
                         VerticalAlignment="Top">
                    <ui:Card MinHeight="550" VerticalContentAlignment="Top" VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Top">
                            <ui:InfoBar IsClosable="False"
                                        IsOpen="True"
                                        Message="{Binding ViewModel[SelectClientsFromHere]}"/>
                            <ui:DynamicScrollViewer VerticalAlignment="Top">
                                <ui:ListView ItemsSource="{Binding ViewModel.Clients}"
                                             SelectionMode="Multiple"
                                             Margin="0, 10, 0, 0" MaxHeight="280">
                                    <b:Interaction.Behaviors>
                                        <behaviours:MultiSelectBehaviour SelectedItems="{Binding ViewModel.SelectedClients}" />
                                    </b:Interaction.Behaviors>
                                    
                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtos:DtoClient}">
                                            <StackPanel Orientation="Horizontal" Margin="5">
                                                <TextBlock Text="{Binding Name}"/>
                                                <TextBlock Text="•" Margin="10, 0, 0, 0"/>
                                                <TextBlock Text="{Binding Email}" Margin="10, 0, 0, 0"/>
                                                <TextBlock Text="•" Margin="10, 0, 0, 0"/>
                                                <TextBlock Text="{Binding Phone}" Margin="10, 0, 0, 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ui:ListView>
                            </ui:DynamicScrollViewer>
                        </StackPanel>
                    </ui:Card>
                </TabItem>
            </TabControl.Items>
        </TabControl>
        
        <StackPanel Grid.Row="2" Margin="25, 0, 25, 0">
            <StackPanel Orientation="Horizontal" Margin="0, 25, 0, 0" HorizontalAlignment="Center">
                <Button Content="{Binding ViewModel[CancelButton]}" Margin="0, 0, 0, 0"
                        Command="{Binding ViewModel.CancelCommand}"/>
                <Button Content="{Binding ViewModel[SaveButton]}"
                        Command="{Binding ViewModel.SaveCommand}" Margin="15, 0, 0, 0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>