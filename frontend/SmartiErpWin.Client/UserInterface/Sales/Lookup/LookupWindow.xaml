<ui:FluentWindow
    x:Class="SmartiErpWin.Client.UserInterface.Sales.Lookup.LookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:lookup="clr-namespace:SmartiErpWin.Client.UserInterface.Sales.Lookup"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="450"
    Height="250"
    
    d:DataContext="{d:DesignInstance lookup:LookupWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="250"
    d:DesignWidth="450"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    ResizeMode="NoResize"
    WindowCornerPreference="Round"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding ViewModel.ApplicationTitle}"
            Grid.Row="0"
            ShowMaximize="False"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/wpfui-icon-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        
        <StackPanel HorizontalAlignment="Center" Grid.Row="1"
                    VerticalAlignment="Top"
                    Visibility="{Binding ViewModel.UiVisibility}">
            <TextBlock Text="{Binding ViewModel.InfoText}" Margin="0, 25, 0, 0"
                   HorizontalAlignment="Center"
                   MaxWidth="350"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   FontSize="18"/>

            <ui:TextBox Margin="0, 25, 0, 0"
                PlaceholderText="{Binding ViewModel[InvoiceNumber]}"
                Text="{Binding ViewModel.LookupNumber}"
                Width="250"/>
 
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{Binding ViewModel[ReturnAll]}"
                           Margin="0, 25, 0, 0"
                           Width="160"
                           Height="35"
                           HorizontalAlignment="Center"
                           Command="{Binding ViewModel.ActionCommand}"
                           CommandParameter="F"/>
            
                <ui:Button Content="{Binding ViewModel[SelectWhatToReturn]}"
                           Margin="15, 25, 0, 0"
                           Width="160"
                           Height="35"
                           HorizontalAlignment="Center"
                           Command="{Binding ViewModel.ActionCommand}"
                           CommandParameter="P"/>   
            </StackPanel>

        </StackPanel>
        <prefabs:RefreshPrefab Grid.Row="1" RingVisibility="{Binding ViewModel.RingVisibility}"
                               LoadingInfo="{Binding ViewModel.LoadingInfo}"
                               LoadingTitle="{Binding ViewModel.LoadingTitle}"
                               IsRefreshing="{Binding ViewModel.IsRefreshing}"
                               LoadingTitleSize="20"/>
    </Grid>
</ui:FluentWindow>
