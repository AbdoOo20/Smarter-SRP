<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Height="360"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="NoResize"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="400"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance lookup:ItemSelectionWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="360"
    d:DesignWidth="400"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Sales.Lookup.ItemSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:lookup="clr-namespace:SmartiErpWin.Client.UserInterface.Sales.Lookup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar
            Height="20"
            ShowClose="{Binding ViewModel.IsRefreshing}"
            ShowMaximize="False"
            ShowMinimize="False"
            x:Name="TitleBar" />

        <StackPanel
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            VerticalAlignment="Top"
            Visibility="{Binding ViewModel.UiVisibility}"
            Width="380">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox
                    Margin="0,5,0,0"
                    MinWidth="215"
                    PlaceholderText="{Binding ViewModel[Search]}"
                    TabIndex="0"
                    Text="{Binding ViewModel.SearchText}"
                    TextChanged="TextBoxBase_OnTextChanged"
                    x:Name="FocusTarget" />
                <StackPanel Margin="5,0" MinWidth="120">
                    <ComboBox
                        ItemsSource="{Binding ViewModel.ComboModelBase.ApiCol1}"
                        Margin="0,6,0,0"
                        MinWidth="160"
                        SelectedItem="{Binding ViewModel.ComboModelBase.Api1}"
                        SelectionChanged="CategorySelectionChanged"
                        TabIndex="2">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

            </StackPanel>

            <ui:Card Margin="0,3,0,0" Padding="2">
                <ui:DynamicScrollViewer VerticalAlignment="Top">
                    <ui:ListView
                        ItemsSource="{Binding ViewModel.ModelsInView}"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabNavigation="Continue"
                        Margin="0,10,0,0"
                        MaxHeight="230"
                        MinHeight="230"
                        MouseDoubleClick="ListView_OnMouseDoubleClick"
                        SelectedItem="{Binding ViewModel.SelectedItem}"
                        SelectionMode="Single"
                        x:Name="ListView">

                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <StackPanel Margin="5" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ui:ListView>
                </ui:DynamicScrollViewer>
            </ui:Card>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button
                    Command="{Binding ViewModel.CancelCommand}"
                    CommandParameter="F"
                    Content="{Binding ViewModel[Cancel]}"
                    Height="32"
                    HorizontalAlignment="Center"
                    Margin="3,10,0,0"
                    Width="100" />

                <ui:Button
                    Command="{Binding ViewModel.ClearSelectionCommand}"
                    CommandParameter="F"
                    Content="{Binding ViewModel[SelectNone]}"
                    Height="32"
                    HorizontalAlignment="Center"
                    Margin="3,10,0,0"
                    Width="140" />

                <ui:Button
                    Command="{Binding ViewModel.SelectCommand}"
                    CommandParameter="P"
                    Content="{Binding ViewModel[Select]}"
                    Height="32"
                    HorizontalAlignment="Center"
                    Margin="3,10,0,0"
                    Width="100" />
            </StackPanel>
        </StackPanel>
        <prefabs:RefreshPrefab
            Grid.Row="1"
            IsRefreshing="{Binding ViewModel.IsRefreshing}"
            LoadingInfo="{Binding ViewModel.LoadingInfo}"
            LoadingTitle="{Binding ViewModel.LoadingTitle}"
            LoadingTitleSize="20"
            RingVisibility="{Binding ViewModel.RingVisibility}" />
    </Grid>
</ui:FluentWindow>
