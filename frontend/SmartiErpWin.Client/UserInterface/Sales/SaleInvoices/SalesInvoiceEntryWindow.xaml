<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="750"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1100"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    d:DataContext="{d:DesignInstance saleInvoices:SalesInvoiceEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Sales.SaleInvoices.SalesInvoiceEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:saleInvoices="clr-namespace:SmartiErpWin.Client.UserInterface.Sales.SaleInvoices"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <prefabs:RefreshPrefab
            Grid.Row="1"
            HorizontalAlignment="Center"
            IsRefreshing="{Binding ViewModel.IsRefreshing}"
            LoadingInfo="{Binding ViewModel.LoadingInfo}"
            LoadingTitle="{Binding ViewModel.LoadingTitle}"
            VerticalAlignment="Center"
            Visibility="{Binding ViewModel.RingVisibility}" />

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            DockPanel.Dock="Top"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Style="{StaticResource ImageIconStyle}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <ui:DynamicScrollViewer Grid.Row="1" Visibility="{Binding ViewModel.UiVisibility}">
            <DockPanel Margin="0,0,0,0">
                <StackPanel DockPanel.Dock="Top">
                    <ui:Card Margin="25,0">
                        <WrapPanel>
                            <StackPanel>
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNumber]}" />
                                <TextBox
                                    IsReadOnly="True"
                                    Margin="0,10,0,0"
                                    MinWidth="100"
                                    Text="{Binding ViewModel.InvoiceNumber}" />
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.SerialNumberVisibility}">
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SerialNumber]}" />
                                <TextBox
                                    Margin="0,10,0,0"
                                    MinWidth="120"
                                    Text="{Binding ViewModel.Model.DtoSalesInvoice.SerialNumber}" />
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Left"
                                Margin="10,10,0,0"
                                Orientation="Vertical">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Date]}" />
                                <DatePicker
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    MinWidth="140"
                                    SelectedDate="{Binding ViewModel.Model.DtoSalesInvoice.Date}" />
                            </StackPanel>

                            <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.FullVisibility}">
                                <prefabs:AutoSuggestPrefab
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiCol1}"
                                    Margin="0,10,0,0"
                                    MinComboWidth="220"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.Api1}"
                                    TitleText="{Binding ViewModel[Client]}" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PaymentType]}" />
                                <ComboBox
                                    ItemsSource="{Binding ViewModel.ComboModelBase.StaticComboItems}"
                                    Margin="0,10,0,0"
                                    MinWidth="170"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedStaticComboItem}" />
                            </StackPanel>


                            <StackPanel Visibility="Collapsed">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[PaymentMethod]}" />

                                <ComboBox
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[3]}"
                                    Margin="0,10,0,0"
                                    MinWidth="200"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[3]}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="10,10,0,0"
                                Visibility="{Binding ViewModel.SafeVisibility}">
                                <prefabs:QuaAutoSuggestPrefab
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}"
                                    MinComboWidth="150"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}"
                                    TitleText="{Binding ViewModel[Safe]}" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="10,10,0,0"
                                Visibility="{Binding ViewModel.FullVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[StorageType]}" />
                                <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                    <ComboBox
                                        ItemsSource="{Binding ViewModel.TertiaryComboModelBase.StaticComboItems}"
                                        Margin="0,10,0,0"
                                        MinWidth="170"
                                        SelectedItem="{Binding ViewModel.TertiaryComboModelBase.SelectedStaticComboItem}"
                                        SelectionChanged="OnStorageTypeChanged" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="10,10,0,0" Visibility="{Binding ViewModel.NormalStoreVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Store]}" />
                                <ComboBox
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}"
                                    Margin="0,10,0,0"
                                    MinWidth="170"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}"
                                    SelectionChanged="StoreSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="10,10,0,0" Visibility="{Binding ViewModel.MarketerStoreVisibility}">
                                <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[MarketerStore]}" />
                                <ComboBox
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[5]}"
                                    Margin="0,10,0,0"
                                    MinWidth="170"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[5]}"
                                    SelectionChanged="StoreSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                            <TextBlock Text="{Binding Display}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,0">
                                <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.FullVisibility}">
                                    <prefabs:TerAutoSuggestPrefab
                                        ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[4]}"
                                        Margin="0,10,0,0"
                                        MinComboWidth="220"
                                        OnSelectionChanged="OnRepresentativeChanged"
                                        SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[4]}"
                                        TitleText="{Binding ViewModel[RepresentativeMarketer]}" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </ui:Card>

                    <ui:Card Margin="25,0" Padding="12,12">
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Margin="0,5,0,0" Text="{Binding ViewModel[Notes]}" />
                            <TextBox
                                Margin="0,5,0,0"
                                Text="{Binding ViewModel.Model.DtoSalesInvoice.Notes}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <StackPanel Margin="25,5">
                    <ui:Card>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:InfoBar
                                    HorizontalAlignment="Left"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Margin="0,0,0,0"
                                    Message="{Binding ViewModel.TotalPrice}"
                                    MinWidth="200"
                                    Title="{Binding ViewModel[TotalPrice]}" />
                                <StackPanel Margin="10,0,0,15" Visibility="{Binding ViewModel.FullVisibility}">
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[DiscountType]}" />
                                    <ComboBox
                                        ItemsSource="{Binding ViewModel.SecondaryComboModelBase.StaticComboItems}"
                                        Margin="0,5,0,0"
                                        MinWidth="150"
                                        SelectedItem="{Binding ViewModel.SecondaryComboModelBase.SelectedStaticComboItem}" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,15" Visibility="{Binding ViewModel.FullVisibility}">
                                    <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Discount]}" />
                                    <TextBox
                                        Margin="0,5,0,0"
                                        MinWidth="120"
                                        Text="{Binding ViewModel.Model.DtoSalesInvoice.Discount}"
                                        TextChanged="OnDiscountTextChanged" />
                                </StackPanel>
                            </StackPanel>
                            <ui:DynamicScrollViewer
                                HorizontalScrollBarVisibility="Visible"
                                Margin="0,10,0,0"
                                Padding="5"
                                x:Name="DataScroller">
                                <StackPanel x:Name="DataGrid" />
                            </ui:DynamicScrollViewer>

                            <saleInvoices:SalesInvoiceDetailsEntryWindow MinHeight="200" x:Name="EntryState" />
                        </StackPanel>
                    </ui:Card>

                    <StackPanel
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,10"
                        Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Command="{Binding ViewModel.CancelCommand}"
                                Content="{Binding ViewModel[CancelButton]}"
                                Height="35"
                                Margin="0,0,0,0"
                                MinWidth="100" />
                            <Button
                                Command="{Binding ViewModel.SavePrintCommand}"
                                Content="{Binding ViewModel[SavePrintButton]}"
                                Height="35"
                                Margin="15,0,0,0"
                                MinWidth="100" />
                            <Button
                                Command="{Binding ViewModel.SaveCommand}"
                                Content="{Binding ViewModel[SaveButton]}"
                                Height="35"
                                Margin="15,0,0,0"
                                MinWidth="100" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Left"
                        Margin="20,35,0,0"
                        Orientation="Horizontal" />
                </StackPanel>
            </DockPanel>
        </ui:DynamicScrollViewer>
    </Grid>
</ui:FluentWindow>