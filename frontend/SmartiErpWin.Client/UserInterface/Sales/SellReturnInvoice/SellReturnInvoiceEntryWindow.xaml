                                        MinWidth="150" />
                                </StackPanel>
                                <StackPanel Margin="10, 0, 0, 15" Visibility="{Binding ViewModel.FullVisibility}">
                                    <TextBlock Text="{Binding ViewModel[Discount]}" Margin="0, 0, 0, 0" />
                                    <TextBox Text="{Binding ViewModel.Model.SellInvoiceReturn.Discount}"
                                             MinWidth="120"
                                             Margin="0, 5, 0, 0"
                                             TextChanged="OnDiscountTextChanged" />
                                </StackPanel>
                            </StackPanel>

