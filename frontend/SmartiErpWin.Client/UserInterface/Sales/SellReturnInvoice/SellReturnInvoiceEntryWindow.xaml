                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="10, 10, 0, 0"
                                        Visibility="{Binding ViewModel.MarketerStoreVisibility}">
                                <TextBlock Text="{Binding ViewModel[MarketerStore]}"
