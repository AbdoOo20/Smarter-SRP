<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="700"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1000"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    d:DataContext="{d:DesignInstance saleInvoices:SellReturnInvoiceEntryWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Sales.SellReturnInvoice.SellReturnInvoiceEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:saleInvoices="clr-namespace:SmartiErpWin.Client.UserInterface.Sales.SellReturnInvoice"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <prefabs:RefreshPrefab
            Grid.Row="1"
            HorizontalAlignment="Center"
            IsRefreshing="{Binding ViewModel.IsRefreshing}"
            LoadingInfo="{Binding ViewModel.LoadingInfo}"
            LoadingTitle="{Binding ViewModel.LoadingTitle}"
            VerticalAlignment="Center"
            Visibility="{Binding ViewModel.RingVisibility}" />

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            DockPanel.Dock="Top"
            Grid.Row="0"
            ShowMaximize="True"
            ShowMinimize="True"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Style="{StaticResource ImageIconStyle}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid
            Grid.Row="1"
            Margin="25"
            Visibility="{Binding ViewModel.UiVisibility}">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <ui:Card Margin="0,0">
                    <WrapPanel>

                        <StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SellInvoiceNumber]}" />
                            <TextBox
                                IsReadOnly="True"
                                Margin="0,10,0,0"
                                MinWidth="100"
                                Text="{Binding ViewModel.SellInvoiceNumber}" />
                        </StackPanel>

                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[InvoiceNumber]}" />
                            <TextBox
                                IsReadOnly="True"
                                Margin="0,10,0,0"
                                MinWidth="100"
                                Text="{Binding ViewModel.InvoiceNumber}" />
                        </StackPanel>

                        <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.SerialNumberVisibility}">
                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[SerialNumber]}" />
                            <TextBox
                                Margin="0,10,0,0"
                                MinWidth="120"
                                Text="{Binding ViewModel.Model.SellInvoiceReturn.SerialNumber}" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Left"
                            Margin="10,10,0,0"
                            Orientation="Vertical">
                            <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Date]}" />
                            <DatePicker
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                MinWidth="140"
                                SelectedDate="{Binding ViewModel.Model.SellInvoiceReturn.Date}" />
                        </StackPanel>

                        <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.FullVisibility}">
                            <prefabs:SecAutoSuggestPrefab
                                ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}"
                                Margin="0,10,0,0"
                                MinComboWidth="170"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                                TitleText="{Binding ViewModel[Client]}" />
                        </StackPanel>

                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Margin="0,10,0,0" Text="{Binding ViewModel[PaymentType]}" />
                            <ComboBox
                                ItemsSource="{Binding ViewModel.ComboModelBase.StaticComboItems}"
                                Margin="0,10,0,0"
                                MinWidth="170"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedStaticComboItem}" />
                        </StackPanel>

                        <StackPanel Visibility="Collapsed">
                            <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[PaymentMethod]}" />

                            <ComboBox
                                ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[3]}"
                                Margin="0,10,0,0"
                                MinWidth="200"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[3]}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Margin="10,10,0,0"
                            Visibility="{Binding ViewModel.SafeVisibility}">
                            <prefabs:QuaAutoSuggestPrefab
                                ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}"
                                MinComboWidth="150"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}"
                                TitleText="{Binding ViewModel[Safe]}" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Margin="10,10,0,0"
                            Visibility="{Binding ViewModel.FullVisibility}">
                            <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[StorageType]}" />
                            <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                                <ComboBox
                                    ItemsSource="{Binding ViewModel.TertiaryComboModelBase.StaticComboItems}"
                                    Margin="0,10,0,0"
                                    MinWidth="170"
                                    SelectedItem="{Binding ViewModel.TertiaryComboModelBase.SelectedStaticComboItem}"
                                    SelectionChanged="OnStorageTypeChanged" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="10,10,0,0" Visibility="{Binding ViewModel.NormalStoreVisibility}">
                            <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[Store]}" />
                            <ComboBox
                                ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}"
                                Margin="0,10,0,0"
                                MinWidth="170"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}"
                                SelectionChanged="StoreSelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="10,10,0,0" Visibility="{Binding ViewModel.MarketerStoreVisibility}">
                            <TextBlock Margin="0,0,0,0" Text="{Binding ViewModel[MarketerStore]}" />
                            <ComboBox
                                ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[5]}"
                                Margin="0,10,0,0"
                                MinWidth="170"
                                SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[5]}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!--<StackPanel Margin="0,0,0,0">
                            <StackPanel Margin="10,0,0,0" Visibility="{Binding ViewModel.FullVisibility}">
                                <prefabs:TerAutoSuggestPrefab
                                    ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[4]}"
                                    Margin="0,10,0,0"
                                    MinComboWidth="170"
                                    SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[4]}"
                                    TitleText="{Binding ViewModel[RepresentativeMarketer]}" />
                            </StackPanel>
                        </StackPanel>-->

                    </WrapPanel>

                </ui:Card>

                <ui:Card Margin="0,0" Padding="12,12">
                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Margin="0,5,0,0" Text="{Binding ViewModel[Notes]}" />
                        <TextBox
                            Margin="0,5,0,0"
                            Text="{Binding ViewModel.Model.SellInvoiceReturn.Notes}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>

            <ui:DynamicScrollViewer Grid.Row="1">
                <StackPanel x:Name="DataGrid" />
            </ui:DynamicScrollViewer>

            <saleInvoices:SellReturnInvoiceDetailsEntryWindow
                Grid.Row="2"
                Height="auto"
                x:Name="EntryState" />

            <StackPanel
                DockPanel.Dock="Bottom"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <Button
                        Command="{Binding ViewModel.CancelCommand}"
                        Content="{Binding ViewModel[CancelButton]}"
                        Height="35"
                        Margin="0,0,0,0"
                        MinWidth="100" />
                    <Button
                        Command="{Binding ViewModel.SavePrintCommand}"
                        Content="{Binding ViewModel[SavePrintButton]}"
                        Height="35"
                        Margin="15,0,0,0"
                        MinWidth="100" />
                    <Button
                        Command="{Binding ViewModel.SaveCommand}"
                        Content="{Binding ViewModel[SaveButton]}"
                        Height="35"
                        Margin="15,0,0,0"
                        MinWidth="100" />
                </StackPanel>
            </StackPanel>
        </Grid>

