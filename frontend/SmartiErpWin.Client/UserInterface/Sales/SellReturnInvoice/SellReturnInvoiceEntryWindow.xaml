                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel[SellInvoiceNumber]}" Margin="0, 10, 0, 0" />
                                <TextBox Text="{Binding ViewModel.SellInvoiceNumber}" MinWidth="100" Margin="0, 10, 0, 0"
