                                     Margin="0, 5, 0, 0"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>

                <StackPanel Margin="25, 5">

                    <ui:Card>
                        <StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <ui:InfoBar IsOpen="True" IsClosable="False"
                                            Margin="0, 0, 0, 0"
                                            Title="{Binding ViewModel[TotalPrice]}"
                                            Message="{Binding ViewModel.TotalPrice}"
                                            MinWidth="200" HorizontalAlignment="Left" />
                                <StackPanel Margin="10, 0, 0, 15" Visibility="{Binding ViewModel.FullVisibility}">
