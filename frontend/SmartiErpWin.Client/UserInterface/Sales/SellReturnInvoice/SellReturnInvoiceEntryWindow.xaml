                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </ui:Card>

                    <ui:Card Margin="25, 0" Padding="12, 12">
                        <StackPanel Margin="0, 0, 0, 0">
                            <TextBlock Text="{Binding ViewModel[Notes]}" Margin="0, 5, 0, 0"/>
