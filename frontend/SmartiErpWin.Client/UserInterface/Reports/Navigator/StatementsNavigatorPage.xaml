<Page
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    SizeChanged="OnDataSizeChanged"
    d:DataContext="{d:DesignInstance navigator:StatementsNavigatorPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Class="SmartiErpWin.Client.UserInterface.Reports.Navigator.StatementsNavigatorPage"
    x:Name="Navigator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigator="clr-namespace:SmartiErpWin.Client.UserInterface.Reports.Navigator"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:uiModels="clr-namespace:SmartiErpWin.Client.DtoModels.UiModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.Expanders}">
        <ui:VirtualizingItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type uiModels:ExpanderModel}">
                <ui:CardExpander
                    Header="{Binding Name}"
                    IsExpanded="True"
                    Visibility="{Binding Visibility}"
                    Width="{Binding ActualWidth, ElementName=Navigator}">
                    <StackPanel>
                        <ui:VirtualizingItemsControl
                            ItemsSource="{Binding Cards}"
                            Margin="0,10,0,0"
                            MaxWidth="{Binding ActualWidth, ElementName=Navigator}">
                            <ui:VirtualizingItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type uiModels:CardModel}">
                                    <ui:CardAction
                                        Command="{Binding ActionCommand}"
                                        Height="60"
                                        Margin="5"
                                        Width="300">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Person12" />
                                            <TextBlock Margin="10,0,0,0" Text="{Binding CardName, Converter={StaticResource LocaleConverter}}" />
                                        </StackPanel>
                                    </ui:CardAction>
                                </DataTemplate>
                            </ui:VirtualizingItemsControl.ItemTemplate>
                        </ui:VirtualizingItemsControl>
                    </StackPanel>

                </ui:CardExpander>
            </DataTemplate>
        </ui:VirtualizingItemsControl.ItemTemplate>
    </ui:VirtualizingItemsControl>
</Page>