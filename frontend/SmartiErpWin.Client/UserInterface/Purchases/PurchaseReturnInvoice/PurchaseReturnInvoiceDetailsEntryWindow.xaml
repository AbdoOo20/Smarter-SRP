<UserControl
    x:Class="SmartiErpWin.Client.UserInterface.Purchases.PurchaseReturnInvoice.PurchaseReturnInvoiceDetailsEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
    xmlns:saleInvoices="clr-namespace:SmartiErpWin.Client.UserInterface.Sales.SellReturnInvoice"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    MinWidth="870"
    Height="100"
    d:DesignHeight="100"
    d:DesignWidth="850"
    d:DataContext="{d:DesignInstance saleInvoices:SellReturnInvoiceDetailsEntryWindow,
                                     IsDesignTimeCreatable=True}"

    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    PreviewKeyDown="OnPreviewKeyDown"
    mc:Ignorable="d"
    FlowDirection="RightToLeft">
    <ui:DynamicScrollViewer HorizontalScrollBarVisibility="Visible" Margin="0, 0, 0, 5">
        <StackPanel Margin="10, 5" Orientation="Vertical" HorizontalAlignment="Center">

            <StackPanel Margin="10, 5" Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel MinWidth="120" Margin="5, 0">
                    <TextBlock Text="{Binding ViewModel[Category]}" Margin="0, 10, 0, 0" />
                    <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[3]}" Margin="0, 10, 0, 0"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[3]}"
                              SelectionChanged="CategorySelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel MinWidth="130" Margin="10, 0">
                    <prefabs:AutoSuggestPrefab ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[0]}" Margin="0, 10, 0, 0"
                                       SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[0]}"
                                       TitleText="{Binding ViewModel[Item]}"
                                       MinComboWidth="500"
                                       x:Name="FocusScapegoatCombo"
                                       OnSelectionChanged="ItemSelectionChanged" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="10, 5" Orientation="Horizontal" HorizontalAlignment="Center">

                <StackPanel MinWidth="100" Margin="5, 0">
                    <TextBlock Text="{Binding ViewModel[Unit]}" Margin="0, 10, 0, 0" />
                    <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[1]}" Margin="0, 10, 0, 0"
                      SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[1]}"
                      SelectionChanged="UnitSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel MinWidth="80" MaxWidth="80" Margin="5, 0">
                    <TextBlock Text="{Binding ViewModel[Quantity]}" Margin="0, 10, 0, 0" />
                    <TextBox Text="{Binding ViewModel.Model.Quantity, Converter={StaticResource TextBoxConverter}}"
                     Margin="0, 10, 0, 0" />
                </StackPanel>

                <StackPanel MinWidth="80" MaxWidth="80" Margin="5, 0" Visibility="{Binding ViewModel.FullVisibility}">
                    <TextBlock Text="{Binding ViewModel[Price]}" Margin="0, 10, 0, 0" />
                    <TextBox Text="{Binding ViewModel.SuggestedPrice, Converter={StaticResource TextBoxConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0, 10, 0, 0" />
                </StackPanel>

                <StackPanel MinWidth="80" MaxWidth="100" Margin="5, 0" Visibility="{Binding ViewModel.FullVisibility}">
                    <TextBlock Text="{Binding ViewModel[Discount]}" Margin="0, 10, 0, 0" />
                    <TextBox Text="{Binding ViewModel.Model.Discount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0, 10, 0, 0" />
                </StackPanel>

                <StackPanel MinWidth="100" Margin="5, 0">
                    <TextBlock Text="{Binding ViewModel[ExpireDate]}" Margin="0, 10, 0, 0" />
                    <ComboBox ItemsSource="{Binding ViewModel.ComboModelBase.ApiComboItems[2]}" Margin="0, 10, 0, 0"
                              SelectedItem="{Binding ViewModel.ComboModelBase.SelectedApiComboItems[2]}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Button Width="45" Height="45" Margin="10, 30, 0, 0"
                Command="{Binding ViewModel.SaveCommand}">
                    <ui:SymbolIcon Symbol="{Binding ViewModel.Symbol}" />
                </Button>
            </StackPanel>
        </StackPanel>
    </ui:DynamicScrollViewer>
</UserControl>