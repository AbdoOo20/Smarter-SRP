<ui:FluentWindow
    ExtendsContentIntoTitleBar="True"
    FlowDirection="{Binding ViewModel.FlowDirection}"
    Height="800"
    SizeChanged="MainWindowOnSizeChanged"
    Title="{Binding ViewModel.ApplicationTitle, Mode=OneWay}"
    Width="1200"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    d:DataContext="{d:DesignInstance windows:MainWindow,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="550"
    d:DesignWidth="800"
    mc:Ignorable="d"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Class="SmartiErpWin.Client.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prefabs="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windows="clr-namespace:SmartiErpWin.Client.Views.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:NavigationView
            BreadcrumbBar="{Binding ElementName=BreadcrumbBar}"
            FooterMenuItemsSource="{Binding ViewModel.FooterMenuItems, Mode=OneWay}"
            FrameMargin="0"
            Grid.Row="1"
            Height="{Binding ViewModel.NavHeight}"
            IsBackButtonVisible="Visible"
            IsPaneToggleVisible="True"
            MenuItemsSource="{Binding ViewModel.MenuItems, Mode=OneWay}"
            Padding="42,0,42,0"
            PaneDisplayMode="{Binding ViewModel.NavigationViewPaneDisplay}"
            PaneTitle="{Binding ViewModel[NavigationMenuTitle]}"
            Visibility="{Binding ViewModel.UiVisibility}"
            x:Name="NavigationView">
            <ui:NavigationView.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:BreadcrumbBar Margin="42,32,42,20" x:Name="BreadcrumbBar" />
                </StackPanel>
            </ui:NavigationView.Header>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ContentPresenter
            Grid.Row="0"
            Grid.RowSpan="2"
            x:Name="RootContentDialog" />

        <ui:TitleBar
            CloseWindowByDoubleClickOnIcon="True"
            Grid.Row="0"
            Title="{Binding ViewModel.ApplicationTitle}"
            x:Name="TitleBar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Style="{StaticResource ImageIconStyle}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <prefabs:RefreshPrefab
            Grid.Row="0"
            IsRefreshing="{Binding ViewModel.IsRefreshing}"
            LoadingInfo="{Binding ViewModel.LoadingInfo}"
            LoadingTitle="{Binding ViewModel.LoadingTitle}"
            Margin="0,300,0,0"
            Visibility="{Binding ViewModel.RingVisibility}" />
    </Grid>
</ui:FluentWindow>