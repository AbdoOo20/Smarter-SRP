<UserControl x:Class="SmartiErpWin.Client.Prefabs.TitleBarPrefab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartiErpWin.Client.Prefabs"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:TitleBarPrefab,
                                     IsDesignTimeCreatable=True}"
      x:Name="TitleBarControl"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:TitleBar
        x:Name="TitleBar"
        Title="{Binding Title, ElementName=TitleBarControl}"
        CloseWindowByDoubleClickOnIcon="True">
        <ui:TitleBar.Icon>
            <ui:ImageIcon Style="{StaticResource ImageIconStyle}" />
        </ui:TitleBar.Icon>
    </ui:TitleBar>
</UserControl>
