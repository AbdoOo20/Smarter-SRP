<UserControl x:Class="SmartiErpWin.Client.Prefabs.DynamicAutoSuggestPrefab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartiErpWin.Client.Prefabs"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:dtoModels="clr-namespace:SmartiErpWin.Client.DtoModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:DynamicAutoSuggestPrefab,
                                     IsDesignTimeCreatable=True}"
      x:Name="AutoSuggestControl"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
        <StackPanel>
            <TextBlock Text="{Binding TitleText}"/>
            <ui:Card Width="{Binding MinComboWidth}"
                     Padding="0"
                     x:Name="CardControl"
                     Margin="0, 10, 0, 0">
                <Button Click="OpenClick"
                        Height="35">

                    <DockPanel Width="{Binding ActualWidth}" >
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock Margin="0, 3, 0, 0" Text="{Binding SelectedItem.Display}"
                                       Height="45"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0, 0, 30, 0">
                            <!--
                            <ui:SymbolIcon Symbol="Search12" Margin="0, 0, 15, 0"/>
                            -->
                            <ui:SymbolIcon Symbol="ArrowDown12" Margin="0, 0, 0, 0"/>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </ui:Card>
            
            <Popup x:Name="DataPopup" IsOpen="{Binding IsPopupOpen}"
                   PlacementTarget="{Binding ElementName=CardControl}"
                   Width="{Binding ActualWidth}"
                   StaysOpen="False">
                <Border RenderTransformOrigin="0.5,0.5"
                        BorderBrush="Black"
                        BorderThickness="1">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="PopupStates">
                            <VisualState x:Name="Open">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.3"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Closed">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="0.8" Duration="0:0:0.3"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.3"/>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ui:Card Padding="0" x:Name="TopCard">
                        <ui:Card Margin="0" VerticalAlignment="Stretch"
                                 HorizontalAlignment="Stretch"
                                 Padding="0">
                            <StackPanel Margin="0"
                                        VerticalAlignment="Top">
                                <ui:TextBox Text="{Binding Search}"
                                            PlaceholderText="{Binding SearchPlaceholder, Converter={StaticResource LocaleConverter}}"
                                            TextChanged="OnTextChanged"
                                            VerticalAlignment="Top"
                                            x:Name="SearchBox"/>
                                <ui:DynamicScrollViewer MaxHeight="300"
                                                        VerticalScrollBarVisibility="Visible"
                                                        Margin="0, 0, 0, 0"
                                                        VerticalAlignment="Top">
                                    <ui:Card Padding="0"
                                             VerticalAlignment="Top">
                                        <ui:ListView ItemsSource="{Binding InternalItems}"
                                                     SelectedItem="{Binding InternalSelectedItem}"
                                                     VerticalAlignment="Top">
                                            <ui:ListView.ItemTemplate>
                                                <DataTemplate DataType="{x:Type dtoModels:ComboModel}">
                                                    <TextBlock Text="{Binding Display}" Margin="10, 7, 7, 7"/>
                                                </DataTemplate>
                                            </ui:ListView.ItemTemplate>
                                        </ui:ListView>
                                    </ui:Card>
                                </ui:DynamicScrollViewer>
                            </StackPanel>
                        </ui:Card>
                    </ui:Card>
                </Border>
            </Popup>
        </StackPanel>
    </Grid>
</UserControl>
