<UserControl
    d:DataContext="{d:DesignInstance local:ToolbarPrefab,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d"
    x:Class="SmartiErpWin.Client.Prefabs.ToolbarPrefab"
    x:Name="toolbarPrefab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartiErpWin.Client.Prefabs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel x:Name="DockPanel">
        <StackPanel
            HorizontalAlignment="Left"
            Margin="0,0,0,0"
            Orientation="Horizontal">
            <ui:TextBox
                HorizontalAlignment="Left"
                Margin="0,0,0,0"
                MinWidth="300"
                PlaceholderText="{Binding SearchBar, ElementName=toolbarPrefab}"
                Text="{Binding SearchText, ElementName=toolbarPrefab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
            <Button
                Command="{Binding RefreshCommand, ElementName=toolbarPrefab}"
                Content="{Binding SearchButton, ElementName=toolbarPrefab}"
                Height="40"
                Margin="25,0,0,0"
                Width="80" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <StackPanel IsEnabled="{Binding ActionsEnabled, ElementName=toolbarPrefab}" Orientation="Horizontal">
                <Button
                    Background="{Binding SecondaryButtonColour, ElementName=toolbarPrefab}"
                    Command="{Binding ExtraCommand, ElementName=toolbarPrefab}"
                    Content="{Binding ExtraText, ElementName=toolbarPrefab}"
                    Height="40"
                    Margin="10,0,0,0"
                    Visibility="{Binding ExtraVisibility, ElementName=toolbarPrefab}" />
                <Button
                    Background="{Binding SecondaryButtonColour, ElementName=toolbarPrefab}"
                    Command="{Binding PrintCommand, ElementName=toolbarPrefab}"
                    Content="{Binding PrintText, ElementName=toolbarPrefab}"
                    Height="40"
                    Margin="10,0,0,0"
                    Visibility="{Binding PrintVisibility, ElementName=toolbarPrefab}"
                    Width="80" />
                <Button
                    Background="{Binding PrimaryButtonColour, ElementName=toolbarPrefab}"
                    Command="{Binding AddCommand, ElementName=toolbarPrefab}"
                    Content="{Binding NewButton, ElementName=toolbarPrefab}"
                    Height="40"
                    Margin="10,0,0,0"
                    Visibility="{Binding AddVisibility, ElementName=toolbarPrefab}"
                    Width="80" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>