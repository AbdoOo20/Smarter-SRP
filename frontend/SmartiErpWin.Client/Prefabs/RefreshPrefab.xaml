<UserControl x:Class="SmartiErpWin.Client.Prefabs.RefreshPrefab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartiErpWin.Client.Prefabs"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:RefreshPrefab,
                                     IsDesignTimeCreatable=True}"
      x:Name="RefreshablePrefab"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding RingVisibility, ElementName=RefreshablePrefab}">
        <mah:ProgressRing IsActive="{Binding IsRefreshing, ElementName=RefreshablePrefab}"
                          HorizontalAlignment="Center"
                          Margin="0, 0, 0, 0" DockPanel.Dock="Top"
                          Width="45"
                          Height="45"/>
        <TextBlock Text="{Binding LoadingTitle, ElementName=RefreshablePrefab}"
                   HorizontalAlignment="Center"
                   FontSize="{Binding LoadingTitleSize, ElementName=RefreshablePrefab}"
                   Margin="0, 20, 0, 0"/>
        <TextBlock Text="{Binding LoadingInfo, ElementName=RefreshablePrefab}"
                   HorizontalAlignment="Center"
                   FontSize="18"
                   Margin="0, 10, 0, 0"/>
    </StackPanel>
</UserControl>
